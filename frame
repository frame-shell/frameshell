#!/usr/bin/env bash
# frame – install and manage frameshell, a terminal-styled desktop for CachyOS + Hyprland
#
#   frame install [package...]   install dependencies and link configs (default: all)
#   frame update  [package...]   git pull, back up, relink and re-apply app themes
#   frame remove  <package...>   unlink configs (dependencies stay installed)
#   frame backup  [package...]   snapshot the current configs and app settings
#   frame restore [name|latest]  list backups, or put one back
#   frame theme [list|set <name>|check]
#                                write every app color file from themes/<name>.json
#   frame grub [install|remove]  theme the GRUB boot menu (copies to /boot, needs sudo)
#   frame goxlr                  light the GoXLR in the theme's colors (goxlr-utility)
#   frame login [install|remove] the lockscreen look as the login screen (greetd, needs sudo)
#   frame wallpaper <args…>      passed to frame-wallpaper (backend, set, apply, …)
#   frame spotify <args…>        passed to frame-spotify (login, logout, status)
#   frame layout [tiling|canvas] Hyprland tiling or the infinite canvas
#   frame status                 show what is linked and what is missing
#
# Options: -n/--dry-run (print what would happen), -y/--yes (no questions)

set -euo pipefail

REPO="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/frameshell"
BACKUP_ROOT="$STATE_DIR/backup"
GRUB_THEME_DIR="/boot/grub/themes/frameshell"
GRUB_DEFAULT_FILE="/etc/default/grub"
VENCORD_SRC="${XDG_DATA_HOME:-$HOME/.local/share}/frameshell/vencord"
THEME_STATE="$STATE_DIR/theme"
DEFAULT_THEME=periwinkle

PACKAGES=(ghostty fish starship fastfetch spicetify vencord quickshell hypr wallpaper zed dolphin zen)

# Distro packages each config needs; AUR ones go through paru/yay
declare -A DEPS=(
  [ghostty]="ghostty"
  [fish]="fish"
  [starship]="starship"
  [fastfetch]="fastfetch chafa"
  # curl, jq, openssl: frame-spotify, the Web API helper for the launcher
  [spicetify]="spicetify-cli ttf-jetbrains-mono curl jq openssl"
  [vencord]="vesktop ttf-jetbrains-mono jq git nodejs pnpm"
  # Launcher modes: qt6-websockets (spotify), fd (files), cliphist (clipboard), wtype +
  # unicode-emoji + noto-fonts-emoji (emoji), sound-theme-freedesktop (timer and alarm sound)
  [quickshell]="quickshell ttf-jetbrains-mono ttf-jetbrains-mono-nerd wl-clipboard libpulse pciutils qt6-websockets qt6-imageformats fd cliphist wtype unicode-emoji noto-fonts-emoji sound-theme-freedesktop"
  [hypr]="hypridle"
  # ffmpeg makes the video thumbnails in the wallpaper app; linux-wallpaperengine
  # comes on top when the "both" backend is picked
  [wallpaper]="jq swaybg mpvpaper ffmpeg"
  [zed]="zed ttf-jetbrains-mono"
  # kio-extras: sftp:// and thumbnails; konsole: the F4 terminal panel;
  # archlinux-xdg-menu: the "Open with" list outside Plasma
  [dolphin]="dolphin kio-extras ffmpegthumbs kdegraphics-thumbnailers konsole qt6ct archlinux-xdg-menu breeze-icons ttf-jetbrains-mono"
  [zen]="zen-browser-bin ttf-jetbrains-mono"
)

# App files outside the repo that frame touches or that belong in a backup
declare -A EXTRAS=(
  [fish]=".config/fish/config.fish"
  [spicetify]=".config/spicetify/config-xpui.ini"
  [vencord]=".config/vesktop/settings/settings.json"
  [hypr]=".config/hypr/hyprland.lua .config/hypr/hyprland.conf"
  [wallpaper]=".local/state/frameshell/wallpaper.json"
  [dolphin]=".config/dolphinrc .config/qt6ct/qt6ct.conf .config/kdeglobals"
)

DRY_RUN=0
ASSUME_YES=0
NO_PULL=0
LAST_BACKUP=""

# ── Output ───────────────────────────────────────────────────

# The active theme: its name is kept in $THEME_STATE, periwinkle until one is picked
current_theme() {
  local t=""
  [[ -f $THEME_STATE ]] && t=$(<"$THEME_STATE")
  [[ -n $t && -f $REPO/themes/$t.json ]] || t=$DEFAULT_THEME
  echo "$t"
}

# theme_hex <theme> <role>: "5d6fe8" from themes/<theme>.json, without needing jq
theme_hex() {
  sed -n "s/.*\"$2\": *\"#\([0-9a-fA-F]\{6\}\)\".*/\1/p" "$REPO/themes/$1.json" 2>/dev/null | head -n 1
}

# 24-bit escape for a hex color: fg_hex 5d6fe8 (foreground) or bg_hex 5d6fe8 (background)
fg_hex() { printf '\e[38;2;%d;%d;%dm' "0x${1:0:2}" "0x${1:2:2}" "0x${1:4:2}"; }
bg_hex() { printf '\e[48;2;%d;%d;%dm' "0x${1:0:2}" "0x${1:2:2}" "0x${1:4:2}"; }

# Colors on a terminal, taken from the active theme; FORCE_COLOR keeps them in logs,
# NO_COLOR turns them off
USE_COLOR=0
if [[ -n ${FORCE_COLOR:-} || ( -t 1 && -z ${NO_COLOR:-} ) ]]; then
  USE_COLOR=1
  theme_now=$(current_theme)
  role() { local h; h=$(theme_hex "$theme_now" "$1"); fg_hex "${h:-$2}"; }
  c_text=$(role text e1e4ff)
  c_primary=$(role primary 5d6fe8)
  c_secondary=$(role secondary 93a4f7)
  c_muted=$(role muted 8086b8)
  c_ok=$(role ok 6ee0b6)
  c_warn=$(role warn f2c97d)
  c_danger=$(role danger ff6b9a)
  c_bold=$'\e[1m'
  c_reset=$'\e[0m'
  unset -f role
else
  c_text='' c_primary='' c_secondary='' c_muted='' c_ok='' c_warn='' c_danger='' c_bold='' c_reset=''
fi

header() {
  printf '\n  %s%sframe%s  %sframeshell · CachyOS · Hyprland%s\n\n' \
    "$c_bold" "$c_primary" "$c_reset" "$c_muted" "$c_reset"
}

step() { printf '\n%s●%s %s%s%s\n' "$c_primary" "$c_reset" "$c_bold" "$*" "$c_reset"; }
info() { printf '  %s%s%s\n' "$c_muted" "$*" "$c_reset"; }
ok()   { printf '  %s✓%s %s\n' "$c_ok" "$c_reset" "$*"; }
warn() { printf '  %s!%s %s\n' "$c_warn" "$c_reset" "$*"; }
die()  { printf '%s✗%s %s\n' "$c_danger" "$c_reset" "$*" >&2; exit 1; }

# Runs a command, or only prints it in dry-run mode
run() {
  if ((DRY_RUN)); then
    printf '  %swould run:%s %s\n' "$c_muted" "$c_reset" "$*"
    return 0
  fi
  "$@"
}

# Like run, but hides the command's own output
run_quiet() {
  if ((DRY_RUN)); then
    run "$@"
    return 0
  fi
  "$@" >/dev/null 2>&1
}

confirm() {
  ((ASSUME_YES)) && return 0
  local answer=""
  printf '  %s [Y/n] ' "$1"
  read -r answer || true
  # Typed answers are already on screen; piped ones are echoed so logs read right
  [[ -t 0 ]] || printf '%s\n' "${answer:-y}"
  [[ -z $answer || $answer =~ ^[YyJj] ]]
}

# choose <question> <key|description>...: prints the picked key; the first is the default.
# The menu goes to stderr, so the answer can be captured with $(…).
choose() {
  local question=$1 answer="" i=1 opt
  shift
  local opts=("$@")
  if ((ASSUME_YES)); then
    echo "${opts[0]%%|*}"
    return 0
  fi
  printf '  %s\n' "$question" >&2
  for opt in "${opts[@]}"; do
    printf '    %s%d%s %-11s %s%s%s\n' "$c_primary" "$i" "$c_reset" "${opt%%|*}" "$c_muted" "${opt#*|}" "$c_reset" >&2
    i=$((i + 1))
  done
  printf '  Pick 1-%d [1] ' "${#opts[@]}" >&2
  read -r answer || true
  [[ -t 0 ]] || printf '%s\n' "${answer:-1}" >&2
  [[ $answer =~ ^[0-9]+$ ]] && ((answer >= 1 && answer <= ${#opts[@]})) || answer=1
  echo "${opts[answer - 1]%%|*}"
}

usage() {
  header
  cat <<EOF
  ${c_bold}Usage${c_reset}  frame <command> [package...] [options]

  ${c_bold}Commands${c_reset}
    install [pkg...]      install dependencies and link configs (default: all)
    update  [pkg...]      git pull, back up, relink and re-apply app themes
                          (run "frame update spicetify" after a Spotify update)
    remove  <pkg...>      unlink configs, dependencies stay installed
    backup  [pkg...]      snapshot the current configs and app settings
    restore [name|latest] list backups, or put one back
    theme                 write every app color file from the active theme
    theme list            show the themes, the active one marked
    theme set <name>      switch every app to another theme
    theme check           only report files that are out of date
    grub [install|remove] theme the GRUB boot menu (copies to /boot, needs sudo)
    goxlr                 faders, buttons and animation of the GoXLR in the theme's colors
    login [install|remove] the lockscreen look as the login screen (greetd greeter, needs sudo)
    wallpaper <…>         wallpaper backends, e.g. "frame wallpaper backend mpv"
                          (both|mpv|image; all commands: frame wallpaper help)
    spotify login         connect the Spotify Web API for the launcher (docs/spotify.md)
    spotify status        logged in or not; "spotify logout" forgets the tokens
    layout [tiling|canvas] normal tiling or the infinite canvas (windows on an endless plane)
    status                show what is linked and what is missing

  ${c_bold}Options${c_reset}
    -n, --dry-run         print what would happen, change nothing
    -y, --yes             do not ask for confirmation

  ${c_bold}Packages${c_reset}  ${PACKAGES[*]}
  ${c_bold}Themes${c_reset}    $(theme_ids | tr '\n' ' ')

EOF
}

# ── Helpers ──────────────────────────────────────────────────

is_package() {
  local p
  for p in "${PACKAGES[@]}"; do [[ $p == "$1" ]] && return 0; done
  return 1
}

need_arch() {
  command -v pacman >/dev/null || die "frame needs an Arch-based system (pacman not found)."
}

has_pkg() {
  command -v pacman >/dev/null && pacman -Qq "$1" &>/dev/null
}

aur_helper() {
  local h
  for h in paru yay; do
    command -v "$h" >/dev/null && { echo "$h"; return 0; }
  done
  return 0
}

deps_of() {
  local p d
  for p in "$@"; do
    for d in ${DEPS[$p]}; do echo "$d"; done
  done
}

install_deps() {
  local missing=() p helper
  # Several packages need the same fonts; ask for each package once
  for p in "$@"; do
    [[ " ${missing[*]} " == *" $p "* ]] && continue
    has_pkg "$p" || missing+=("$p")
  done
  if ((${#missing[@]} == 0)); then
    ok "All dependencies already installed"
    return 0
  fi
  info "Missing: ${missing[*]}"

  local noconfirm=()
  ((ASSUME_YES)) && noconfirm=(--noconfirm)
  helper="$(aur_helper)"
  if [[ -n $helper ]]; then
    run "$helper" -S --needed "${noconfirm[@]}" "${missing[@]}"
  else
    warn "No AUR helper (paru/yay) found, AUR packages like spicetify-cli will fail"
    run sudo pacman -S --needed "${noconfirm[@]}" "${missing[@]}"
  fi
}

# Zen's default profile folder, from profiles.ini: the [Install…] entry wins, then the
# profile marked Default=1, then the first one. Prints nothing before Zen's first start.
zen_profile() {
  local dir ini path
  for dir in "$HOME/.zen" "${XDG_CONFIG_HOME:-$HOME/.config}/zen"; do
    ini="$dir/profiles.ini"
    [[ -f $ini ]] || continue
    path=$(awk -F= '
      /^\[/ { install = ($0 ~ /^\[Install/); profile = ($0 ~ /^\[Profile/); marked = 0; last = ""; next }
      install && $1 == "Default" && !inst { inst = substr($0, 9) }
      profile && $1 == "Path" { p = substr($0, 6); if (!first) first = p; last = p }
      profile && $1 == "Default" && $2 == "1" { marked = 1 }
      profile && marked && last != "" && !def { def = last }
      END { print (inst != "" ? inst : (def != "" ? def : first)) }
    ' "$ini")
    [[ -n $path ]] || continue
    [[ $path == /* ]] || path="$dir/$path"
    [[ -d $path ]] && { echo "$path"; return 0; }
  done
  return 0
}

# Where a package is linked to: $HOME, except Zen, whose files go into its profile.
# Prints nothing if that folder does not exist yet.
pkg_root() {
  case $1 in
    zen) zen_profile ;;
    *) echo "$HOME" ;;
  esac
}

# Files of a package, relative to the package root
pkg_files() {
  [[ -d $REPO/$1 ]] || return 0
  (cd "$REPO/$1" && find . \( -type f -o -type l \) | sed 's|^\./||' | sort)
}

# Repo files plus the app files listed in EXTRAS, relative to $HOME (for backups)
managed_files() {
  local root prefix="" f extra
  root="$(pkg_root "$1")"
  [[ -n $root ]] || return 0
  [[ $root == "$HOME" ]] || prefix="${root#"$HOME"/}/"
  while IFS= read -r f; do echo "$prefix$f"; done < <(pkg_files "$1")
  for extra in ${EXTRAS[$1]:-}; do echo "$extra"; done
}

# Prints linked, partial or missing
link_state() {
  local pkg=$1 f root total=0 linked=0
  root="$(pkg_root "$pkg")"
  [[ -n $root ]] || { echo missing; return 0; }
  while IFS= read -r f; do
    total=$((total + 1))
    if [[ -L $root/$f && "$(readlink -f "$root/$f")" == "$REPO/$pkg/$f" ]]; then
      linked=$((linked + 1))
    fi
  done < <(pkg_files "$pkg")
  if ((total > 0 && linked == total)); then echo linked
  elif ((linked > 0)); then echo partial
  else echo missing
  fi
}

installed_packages() {
  local p
  for p in "${PACKAGES[@]}"; do
    [[ $(link_state "$p") == missing ]] || echo "$p"
  done
}

new_backup_dir() {
  echo "$BACKUP_ROOT/$(date +%Y%m%d-%H%M%S)-$1"
}

# Copies files (relative to $HOME, symlinks resolved) into a new backup
snapshot_files() {
  local reason=$1 f n=0
  shift
  LAST_BACKUP="$(new_backup_dir "$reason")"
  for f in "$@"; do
    [[ -e $HOME/$f ]] || continue
    run mkdir -p "$LAST_BACKUP/$(dirname "$f")"
    run cp -L "$HOME/$f" "$LAST_BACKUP/$f"
    n=$((n + 1))
  done
  if ((n)); then ok "Backup $(basename "$LAST_BACKUP") ($n files)"; else info "Nothing to back up"; fi
}

snapshot_pkgs() {
  local reason=$1 p f files=()
  shift
  for p in "$@"; do
    while IFS= read -r f; do files+=("$f"); done < <(managed_files "$p")
  done
  snapshot_files "$reason" "${files[@]}"
}

# Moves existing files that would block stow into the backup folder
backup_conflicts() {
  local pkg=$1 dest=$2 f target root
  root="$(pkg_root "$pkg")"
  while IFS= read -r f; do
    target="$root/$f"
    [[ -e $target || -L $target ]] || continue
    [[ "$(readlink -f "$target")" == "$REPO/$pkg/$f" ]] && continue
    warn "Backing up existing ~/$f"
    run mkdir -p "$dest/$(dirname "$f")"
    run mv "$target" "$dest/$f"
  done < <(pkg_files "$pkg")
}

# stow_pkg <-R|-D> <package>; --no-folding links single files, so apps never write into the repo
stow_pkg() {
  local root
  root="$(pkg_root "$2")"
  run stow --no-folding -d "$REPO" -t "$root" "$1" "$2"
}

# Backs up whatever is in the way, then links the package; skips packages whose
# target folder does not exist yet (Zen before its first start)
link_pkg() {
  local pkg=$1 backup=$2
  if [[ -z $(pkg_root "$pkg") ]]; then
    warn "Nothing to link into yet"
    return 0
  fi
  backup_conflicts "$pkg" "$backup"
  stow_pkg -R "$pkg"
  ok "Config linked"
}

# Backup folder names, newest first
list_backups() {
  [[ -d $BACKUP_ROOT ]] || return 0
  find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort -r
}

link_self() {
  local bin="$HOME/.local/bin/frame"
  [[ "$(readlink -f "$bin" 2>/dev/null)" == "$REPO/frame" ]] && return 0
  run mkdir -p "$HOME/.local/bin"
  run ln -sf "$REPO/frame" "$bin"
  ok "frame is now available as a command (~/.local/bin/frame)"
}

run_post() {
  if declare -F "post_$1" >/dev/null; then "post_$1"; fi
}

# ── Per-package follow-up steps (also run by update) ─────────

post_fish() {
  if [[ ${SHELL##*/} != fish ]]; then
    info "fish is not your login shell. To change it: chsh -s $(command -v fish || echo /usr/bin/fish)"
  fi
}

post_fastfetch() {
  if [[ ! -f $REPO/assets/logo.png ]]; then
    warn "No logo at assets/logo.png, fastfetch shows the distro logo instead"
    info "Put a PNG of your choice there (the folder is git-ignored)"
  fi
}

# The launcher's Spotify bridge (s mode): the frameshell extension plus a token only the
# shell and the client know (frameshell-token.js), so no web page can pose as Spotify.
# Without it the launcher falls back to frame-spotify and MPRIS.
spotify_bridge() {
  local token_file="$STATE_DIR/spotify-bridge.token"
  local token_js="$HOME/.config/spicetify/Extensions/frameshell-token.js"
  if ((DRY_RUN)); then
    info "would write the bridge token to $token_file and $token_js"
  else
    mkdir -p "$STATE_DIR" "$(dirname "$token_js")"
    if [[ ! -s $token_file ]]; then
      (umask 077 && od -An -tx1 -N24 /dev/urandom | tr -d ' \n' >"$token_file")
    fi
    printf 'window.FRAMESHELL_TOKEN = "%s";\n' "$(cat "$token_file")" >"$token_js"
  fi
  run spicetify config extensions frameshell-token.js
  run spicetify config extensions frameshell.js
}

# Spotify updates wipe spicetify's changes, so this runs on every update
post_spicetify() {
  if ! command -v spicetify >/dev/null && ((!DRY_RUN)); then
    warn "spicetify not found, skipping theme activation"
    return 0
  fi
  run spicetify config current_theme Frameshell color_scheme Frameshell
  spotify_bridge

  # The AUR Spotify sits in /opt/spotify, owned by root; spicetify has to write there
  if [[ -d /opt/spotify && ! -w /opt/spotify ]]; then
    info "Spotify in /opt/spotify is not writable for you, spicetify needs that"
    if confirm "Allow it (sudo chmod a+wr on /opt/spotify, as spicetify's docs say)?"; then
      run sudo chmod a+wr /opt/spotify && run sudo chmod -R a+wr /opt/spotify/Apps
    fi
  fi

  # apply fails on a fresh install or after a Spotify update; a new backup fixes both
  # The quiet first try avoids spicetify's "you haven't backed up" error on a fresh install
  if run_quiet spicetify apply || run spicetify backup apply; then
    ok "Spotify theme applied"
  else
    warn "spicetify failed. Open Spotify once, log in, then run: frame update spicetify"
    info "Still broken after a Spotify update? Try: spicetify restore backup apply"
    info "Spotify from the AUR may need write access: https://spicetify.app/docs/advanced-usage/installation#spotify-installed-from-aur"
  fi
}

# jq in place: json_edit <file> [jq options…] <filter>
json_edit() {
  local file=$1 tmp
  shift
  tmp="$(mktemp)"
  jq "$@" "$file" >"$tmp" && mv "$tmp" "$file"
}

# ── Vencord build with the ShellBridge plugin ────────────────
# Vesktop ships its own Vencord, but user plugins need a self-built one. frame keeps a
# clone in ~/.local/share/frameshell/vencord and rebuilds only when Vencord or the
# plugin changed.

vencord_plugin_hash() {
  (cd "$REPO/vencord/plugins" && find shellBridge -type f -print0 | sort -z | xargs -0 sha1sum) | sha1sum | cut -c1-12
}

vencord_build() {
  step "Vencord with ShellBridge"
  if [[ -d $VENCORD_SRC/.git ]]; then
    run git -C "$VENCORD_SRC" pull --ff-only --quiet || warn "Could not update Vencord, building the version that is there"
  else
    info "Getting Vencord (first time only)"
    run mkdir -p "$(dirname "$VENCORD_SRC")"
    run git clone --depth 1 --quiet https://github.com/Vendicated/Vencord.git "$VENCORD_SRC"
  fi

  local marker="$STATE_DIR/vencord-build" wanted=""
  [[ -d $VENCORD_SRC/.git ]] && wanted="$(git -C "$VENCORD_SRC" rev-parse --short HEAD)-$(vencord_plugin_hash)"
  if [[ -n $wanted && -d $VENCORD_SRC/dist && -f $marker && "$(cat "$marker")" == "$wanted" ]]; then
    ok "Vencord build up to date"
    return 0
  fi

  run rm -rf "$VENCORD_SRC/src/userplugins/shellBridge"
  run mkdir -p "$VENCORD_SRC/src/userplugins"
  run cp -r "$REPO/vencord/plugins/shellBridge" "$VENCORD_SRC/src/userplugins/shellBridge"
  info "Building Vencord, this takes about a minute"
  if run pnpm -C "$VENCORD_SRC" install --frozen-lockfile --silent && run pnpm -C "$VENCORD_SRC" build; then
    # A build that silently left the plugin out is worse than a failed one
    if ((!DRY_RUN)) && ! grep -q "shellbridge-watch" "$VENCORD_SRC/dist/vencordDesktopRenderer.js" 2>/dev/null; then
      warn "The Vencord build does not contain ShellBridge; run: frame update vencord"
      return 1
    fi
    if ((!DRY_RUN)); then
      mkdir -p "$STATE_DIR"
      echo "$wanted" >"$marker"
    fi
    ok "Vencord built with ShellBridge"
  else
    warn "Vencord build failed, Vesktop keeps its own Vencord (the theme still works)"
    return 1
  fi
}

# Builds Vencord with ShellBridge, points Vesktop at it and turns on theme and plugin.
# Vesktop has to be closed while its settings are written, otherwise it writes its own
# copy back on exit.
post_vencord() {
  local built=0
  if command -v pnpm >/dev/null || ((DRY_RUN)); then
    vencord_build && built=1
  else
    warn "pnpm not found, skipping the ShellBridge plugin (the theme still works)"
  fi

  local vesktop="$HOME/.config/vesktop/state.json"
  local vencord="$HOME/.config/vesktop/settings/settings.json"
  if [[ ! -f $vencord ]]; then
    info "Start Vesktop once, close it, then run: frame update vencord"
    return 0
  fi
  if command -v pgrep >/dev/null && pgrep -fi vesktop >/dev/null; then
    warn "Vesktop is running. Close it and run: frame update vencord"
    return 0
  fi
  if ((DRY_RUN)); then
    info "would enable the theme and ShellBridge in $vencord"
    info "would set the Vencord location in $vesktop to $VENCORD_SRC/dist"
    return 0
  fi
  if ! command -v jq >/dev/null; then
    warn "jq not found, enable it by hand: Settings → Themes → Frameshell, Plugins → ShellBridge"
    return 0
  fi

  json_edit "$vencord" '.enabledThemes = ((.enabledThemes // []) + ["frameshell.theme.css"] | unique)'
  ok "Theme enabled"
  if ((built)) || [[ -d $VENCORD_SRC/dist ]]; then
    json_edit "$vencord" '.plugins.ShellBridge.enabled = true'
    [[ -f $vesktop ]] || echo '{}' >"$vesktop"
    # Vesktop's "Vencord location": the dist folder of the build
    # Vesktop keeps "Vencord location" in state.json (not settings.json)
    json_edit "$vesktop" --arg dir "$VENCORD_SRC/dist" '.vencordDir = $dir'
    ok "ShellBridge enabled, Vesktop uses the frameshell Vencord build"
    info "Start Vesktop to load it"
  fi
  return 0
}

# ini_set <file> <section> <key> <value>: sets one key in an INI file (KDE, qt6ct),
# adds the section or key when missing and leaves everything else alone
ini_set() {
  local file=$1 section=$2 key=$3 value=$4 tmp
  if ((DRY_RUN)); then
    info "would set [$section] $key=$value in ${file/#"$HOME"/\~}"
    return 0
  fi
  mkdir -p "$(dirname "$file")"
  [[ -f $file ]] || : >"$file"
  tmp="$(mktemp)"
  # Blank lines are held back, so a new key lands before the gap to the next section
  awk -v s="[$section]" -v k="$key" -v v="$value" '
    function emit() { if (insec && !done) { print k "=" v; done = 1 } }
    function flush() { while (blank > 0) { print ""; blank-- } }
    /^[[:space:]]*$/ { blank++; next }
    /^\[/ { emit(); flush(); insec = ($0 == s); if (insec) seen = 1; print; next }
    insec && index($0, k "=") == 1 { flush(); if (!done) { print k "=" v; done = 1 }; next }
    { flush(); print }
    END { emit(); flush(); if (!seen) { if (NR) print ""; print s; print k "=" v } }
  ' "$file" >"$tmp"
  cat "$tmp" >"$file"
  rm -f "$tmp"
}

