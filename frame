  info "Change the backend later with: frame wallpaper backend both|mpv|image"
}

# ── Notification daemons ─────────────────────────────────────
# Only one program can own the notification service on D-Bus. mako, dunst or
# swaync would take the notifications away from the shell; so would noctalia, the shell
# CachyOS ships with Hyprland (its bar, launcher and keys go too, frameshell has its own).

notification_conflicts() {
  local d
  for d in mako dunst swaync noctalia; do
    if { command -v pgrep >/dev/null && pgrep -x "$d" >/dev/null; } \
      || systemctl --user is-enabled "$d.service" >/dev/null 2>&1 \
      || grep -qsE "^[[:space:]]*exec(-once)?[[:space:]]*=.*\b$d\b" "$HOME"/.config/hypr/*.conf \
      || grep -qsE "exec_cmd\([^)]*\b$d\b" "$HOME"/.config/hypr/*.lua; then
      echo "$d"
    fi
  done
  return 0
}

# Stops them, disables their user services and comments out their autostart lines
# (exec-once in hyprland.conf, hl.exec_cmd in hyprland.lua)
disable_notification_daemons() {
  local d f files=()
  for f in "$HOME"/.config/hypr/*.conf "$HOME"/.config/hypr/*.lua; do
    [[ -f $f && ! -L $f ]] && files+=("${f#"$HOME"/}")
  done
  snapshot_files notification-daemons "${files[@]}"
  for d in "$@"; do
    if systemctl --user is-enabled "$d.service" >/dev/null 2>&1; then
      run systemctl --user disable --now "$d.service" || true
    fi
    if command -v pkill >/dev/null; then
      run pkill -x "$d" || true
    fi
    for f in "${files[@]}"; do
      if [[ $f == *.lua ]]; then
        run sed -i -E "s|^([[:space:]]*hl\\.exec_cmd\\(.*\\b$d\\b.*)|-- frame: \\1|" "$HOME/$f"
      else
        run sed -i -E "s|^([[:space:]]*exec(-once)?[[:space:]]*=.*\\b$d\\b.*)|# frame: \\1|" "$HOME/$f"
      fi
    done
  done
  ok "Turned off: $* (frame restore brings them back)"
}

post_quickshell() {
  local found=()
  mapfile -t found < <(notification_conflicts)
  if ((${#found[@]})); then
    warn "Other notification daemons found: ${found[*]}"
    info "Only one program can show notifications; for the shell's popups they have to go"
    if confirm "Turn them off?"; then
      disable_notification_daemons "${found[@]}"
    else
      info "Left them on; notifications go to ${found[0]} instead of the shell"
    fi
  fi
  info "Quickshell reloads on its own. Test the lockscreen with: qs ipc call lock lock"
  if command -v pgrep >/dev/null && ! pgrep -x qs >/dev/null && ! pgrep -x quickshell >/dev/null; then
    info "Quickshell is not running yet; start it with: qs -d (or log in again)"
  fi
  return 0
}

# Hooks frame/shell.lua into the user's own hyprland.lua instead of owning it.
# Hyprland 0.55+ reads hyprland.lua first; hyprland.conf (hyprlang) is being dropped.
post_hypr() {
  local lua="$HOME/.config/hypr/hyprland.lua" conf="$HOME/.config/hypr/hyprland.conf"
  local line='require("frame/shell")'
  if [[ ! -f $lua ]]; then
    if [[ -f $conf ]]; then
      warn "Your Hyprland config is hyprland.conf, the old format; frameshell's Hyprland files are Lua"
      info "Hyprland 0.55+ reads hyprland.lua instead and drops hyprland.conf soon. Move your settings to"
      info "hyprland.lua (Hyprland's example: https://github.com/hyprwm/Hyprland/blob/main/example/hyprland.lua),"
      info "then run: frame install hypr"
    else
      warn "No ~/.config/hypr/hyprland.lua found. Add this line to your Hyprland config:"
      info "$line"
    fi
    return 0
  fi
  if grep -qF "$line" "$lua"; then
    ok "hyprland.lua already loads frame/shell"
  else
    snapshot_files hyprland-lua ".config/hypr/hyprland.lua"
    if ((DRY_RUN)); then
      info "would append to $lua: $line"
    else
      printf '\n-- frameshell: Quickshell, keybinds, idle, hotkey overlay and window colors\n%s\n' "$line" >>"$lua"
      ok "Added to hyprland.lua: $line"
    fi
  fi
  # Binds frame adds (frame/shell.lua, frame/apps.lua) that the user's config may already
  # have, as hl.bind("SUPER + L", …) or hl.bind(mainMod .. " + L", …); a doubled bind runs both
  local key dupes=()
  for key in L SPACE C W E B; do
    grep -qiE "hl\.bind\([^,]*(SUPER|mainMod)[^,]*\+ *$key\"" "$lua" && dupes+=("SUPER+$key")
  done
  if ((${#dupes[@]})); then
    warn "hyprland.lua also binds ${dupes[*]}; frame binds them too, remove your lines to avoid doubles"
  fi
  if grep -qE 'exec_cmd\("hypridle' "$lua"; then
    warn "hyprland.lua starts hypridle too; remove that line, frame/shell.lua starts it"
  fi
  if command -v hyprctl >/dev/null && ((!DRY_RUN)); then
    hyprctl reload >/dev/null && ok "Hyprland reloaded"
  fi
  return 0
}

# ── GRUB ─────────────────────────────────────────────────────
# GRUB reads its theme from /boot before /home exists, so the theme is
# copied there instead of linked.

need_grub() {
  [[ -f /boot/grub/grub.cfg ]] && command -v grub-mkconfig >/dev/null \
    || die "This system does not boot with GRUB (no /boot/grub/grub.cfg)."
}

# Path of a JetBrains Mono TTF in the given style (Regular, Bold)
grub_font_src() {
  local style=$1 f
  for f in /usr/share/fonts/TTF/JetBrainsMono-"$style".ttf \
           /usr/share/fonts/truetype/jetbrains-mono/JetBrainsMono-"$style".ttf; do
    [[ -f $f ]] && { echo "$f"; return 0; }
  done
  f=$(fc-match -f '%{file}' "JetBrains Mono:style=$style" 2>/dev/null || true)
  [[ $f == *JetBrains* ]] && echo "$f"
  return 0
}

grub_apply() {
  step "Fonts"
  local tmp regular bold
  tmp="$(mktemp -d)"
  regular=$(grub_font_src Regular)
  bold=$(grub_font_src Bold)
  if [[ -z $regular || -z $bold ]] && ((!DRY_RUN)); then
    die "JetBrains Mono not found (install ttf-jetbrains-mono)"
  fi
  # Names must match theme.txt: "Frame Mono Regular 16" etc.
  run grub-mkfont -n "Frame Mono" -s 14 -o "$tmp/frame-regular-14.pf2" "$regular"
  run grub-mkfont -n "Frame Mono" -s 16 -o "$tmp/frame-regular-16.pf2" "$regular"
  run grub-mkfont -n "Frame Mono" -s 16 -o "$tmp/frame-bold-16.pf2" "$bold"
  ok "Fonts built"

  step "Theme files"
  # theme.txt comes from the theme templates; the frame pieces are drawn here
  local theme line_color select_color f
  theme=$(current_theme)
  line_color=$(theme_hex "$theme" surface2)
  select_color=$(theme_hex "$theme" primary)
  [[ -f $REPO/grub/frameshell/theme.txt ]] || theme_render "$theme" 0 quiet
  for f in border select_c select_e select_n select_ne select_s select_se; do
    png_solid "$tmp/$f.png" 1 "$line_color"
  done
  # The left edge of the selected entry is a 3px bar in the primary color
  for f in select_nw select_w select_sw; do
    png_solid "$tmp/$f.png" 3 "$select_color"
  done
  run sudo install -d "$GRUB_THEME_DIR"
  run sudo cp "$REPO/grub/frameshell/theme.txt" "$tmp"/*.png "$tmp"/*.pf2 "$GRUB_THEME_DIR/"
  rm -rf "$tmp"
  ok "Copied to $GRUB_THEME_DIR"

  step "GRUB config"
  if [[ ! -f $STATE_DIR/grub-default.orig ]]; then
    run mkdir -p "$STATE_DIR"
    run cp "$GRUB_DEFAULT_FILE" "$STATE_DIR/grub-default.orig"
    ok "Original saved to $STATE_DIR/grub-default.orig"
  fi
  local line="GRUB_THEME=\"$GRUB_THEME_DIR/theme.txt\""
  if grep -qE '^#?GRUB_THEME=' "$GRUB_DEFAULT_FILE"; then
    run sudo sed -i -E "s|^#?GRUB_THEME=.*|$line|" "$GRUB_DEFAULT_FILE"
  else
    run sudo sed -i "\$a $line" "$GRUB_DEFAULT_FILE"
  fi
  ok "Set $line"
  # A theme needs the graphical terminal
  if grep -qE '^GRUB_TERMINAL_OUTPUT=.*console' "$GRUB_DEFAULT_FILE"; then
    run sudo sed -i -E 's|^(GRUB_TERMINAL_OUTPUT=.*console.*)|#\1|' "$GRUB_DEFAULT_FILE"
    warn "Commented out GRUB_TERMINAL_OUTPUT=console"
  fi

  step "grub.cfg"
  run sudo grub-mkconfig -o /boot/grub/grub.cfg
  ok "Rebuilt /boot/grub/grub.cfg"
}

# ── GoXLR lighting ──────────────────────────────────────────
# The GoXLR's lights follow the theme: faders as a gradient meter from secondary (top) to
# primary, mute and cough buttons primary when off (dimmed) and danger when muted, global
# and accent light in primary and accent, and the "Simple" animation (the only one the
# Mini has besides the rainbows) breathing through it. Sent over goxlr-utility's HTTP API
# and saved into the loaded profile, so it survives a restart.
GOXLR_API="${GOXLR_API:-http://localhost:14564}"

goxlr_hex() {
  # "#5d6fe8" → "5D6FE8"
  local v=${1#\#}
  printf '%s' "${v^^}"
}

goxlr_serial() {
  curl -s --max-time 2 "$GOXLR_API/api/get-devices" 2>/dev/null | jq -r '.mixers | keys[0] // empty' 2>/dev/null
}

goxlr_send() {
  # goxlr_send <serial> <command json>
  local out
  out=$(curl -s --max-time 2 -X POST "$GOXLR_API/api/command" -H 'Content-Type: application/json' -d "{\"Command\":[\"$1\",$2]}" 2>/dev/null)
  [[ $out == '"Ok"' ]]
}

# goxlr_lighting <theme id> [quiet]: needs load_palette to have run for that theme
goxlr_lighting() {
  local id=$1 quiet=${2:-} serial
  serial=$(goxlr_serial)
  if [[ -z $serial ]]; then
    [[ -n $quiet ]] || info "No GoXLR (goxlr-utility is not answering on $GOXLR_API)"
    return 0
  fi
  if ((DRY_RUN)); then
    info "would light the GoXLR ($serial) in the ${PALETTE[name]} colors"
    return 0
  fi
  local primary secondary accent danger
  primary=$(goxlr_hex "${PALETTE[colors.primary]}")
  secondary=$(goxlr_hex "${PALETTE[colors.secondary]}")
  accent=$(goxlr_hex "${PALETTE[colors.accent]}")
  danger=$(goxlr_hex "${PALETTE[colors.danger]}")
  local fails=0 f b
  goxlr_send "$serial" "{\"SetSimpleColour\":[\"Global\",\"$primary\"]}" || fails=$((fails + 1))
  goxlr_send "$serial" "{\"SetSimpleColour\":[\"Accent\",\"$accent\"]}" || fails=$((fails + 1))
  for f in A B C D; do
    goxlr_send "$serial" "{\"SetFaderDisplayStyle\":[\"$f\",\"GradientMeter\"]}" || fails=$((fails + 1))
    goxlr_send "$serial" "{\"SetFaderColours\":[\"$f\",\"$secondary\",\"$primary\"]}" || fails=$((fails + 1))
  done
  for b in Fader1Mute Fader2Mute Fader3Mute Fader4Mute Bleep Cough; do
    goxlr_send "$serial" "{\"SetButtonColours\":[\"$b\",\"$danger\",\"$primary\"]}" || fails=$((fails + 1))
    goxlr_send "$serial" "{\"SetButtonOffStyle\":[\"$b\",\"DimmedColour2\"]}" || fails=$((fails + 1))
  done
  # Mod1 is the pace of the Simple animation; Ripple and Mod2 only exist on the full GoXLR
  goxlr_send "$serial" '{"SetAnimationMode":"Simple"}' || fails=$((fails + 1))
  goxlr_send "$serial" '{"SetAnimationMod1":50}' || true
  goxlr_send "$serial" '{"SetAnimationWaterfall":"Down"}' || true
  goxlr_send "$serial" '"SaveProfile"' || fails=$((fails + 1))
  if ((fails)); then
    warn "GoXLR: $fails of the lighting commands failed (goxlr-utility $GOXLR_API)"
  else
    ok "GoXLR lit in the ${PALETTE[name]} colors"
  fi
}

cmd_goxlr() {
  header
  command -v jq >/dev/null || die "frame goxlr needs jq (pacman -S jq)"
  command -v curl >/dev/null || die "frame goxlr needs curl"
  local id
  id=$(current_theme)
  load_palette "$id"
  step "GoXLR lighting (${PALETTE[name]})"
  [[ -n $(goxlr_serial) ]] || die "goxlr-utility is not answering on $GOXLR_API (is goxlr-daemon running?)"
  goxlr_lighting "$id"
}

# ── Login screen ────────────────────────────────────────────
# One user, one screen: the lockscreen's look as the greeter. greetd runs
# frame-greeter-session (greeter/), which starts a small compositor (the one CachyOS
# ships with noctalia-greeter, or cage) with Quickshell drawing greeter/shell.qml. The
# greeter user cannot read your home, so the files go to /usr/share/frameshell/greeter;
# everything under /etc/greetd and /usr/share needs sudo.
GREETD_CONFIG="/etc/greetd/config.toml"
GREETER_DIR="/usr/share/frameshell/greeter"

login_session_command() {
  # The command greetd runs for the session, the way the distro starts Hyprland
  if [[ -x /usr/bin/start-hyprland ]]; then
    echo "/usr/bin/start-hyprland"
  elif command -v uwsm >/dev/null; then
    echo "uwsm start -e -D Hyprland hyprland.desktop"
  else
    echo "Hyprland"
  fi
}

cmd_login() {
  local action=${1:-install}
  need_arch
  header
  [[ -f $GREETD_CONFIG ]] || die "greetd is not the display manager here ($GREETD_CONFIG is missing); frame login only knows greetd"
  case $action in
    install)
      local user command
      user=$(id -un)
      command=$(login_session_command)
      if [[ ! -x /usr/bin/noctalia-greeter-compositor ]] && ! command -v cage >/dev/null; then
        die "The greeter needs a small compositor: noctalia-greeter (CachyOS) or cage (pacman -S cage)"
      fi
      info "greetd will show the frameshell login screen for $user and start: $command"
      confirm "Set up the lockscreen look as the login screen?" || exit 0
      step "Greeter files"
      run sudo install -d -m 755 "$GREETER_DIR" "$GREETER_DIR/ui"
      run sudo install -m 644 "$REPO/greeter/shell.qml" "$GREETER_DIR/shell.qml"
      run sudo install -m 644 "$REPO/greeter/ui/Frame.qml" "$GREETER_DIR/ui/Frame.qml"
      # The active theme, as the shell has it rendered right now
      run sudo install -m 644 "$REPO/quickshell/.config/quickshell/config/Theme.qml" "$GREETER_DIR/ui/Theme.qml"
      run sudo install -m 755 "$REPO/greeter/frame-greeter-session" "$GREETER_DIR/frame-greeter-session"
      local tmp
      tmp=$(mktemp)
      printf '{ "user": "%s", "command": ["%s"] }\n' "$user" "$command" >"$tmp"
      run sudo install -m 644 "$tmp" "$GREETER_DIR/greeter.json"
      rm -f "$tmp"
      ok "Greeter in $GREETER_DIR (theme $(current_theme))"
      step "greetd"
      if [[ ! -f $STATE_DIR/greetd-config.orig ]]; then
        run mkdir -p "$STATE_DIR"
        run cp "$GREETD_CONFIG" "$STATE_DIR/greetd-config.orig"
        ok "Original config kept at $STATE_DIR/greetd-config.orig"
      fi
      tmp=$(mktemp)
      # Keep [terminal] and any other section, replace default_session
      awk 'BEGIN{skip=0} /^\[default_session\]/{skip=1; next} /^\[/{skip=0} !skip' "$GREETD_CONFIG" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' >"$tmp"
      {
        echo
        echo "# frameshell: the lockscreen look as the login screen (frame login)"
        echo "[default_session]"
        echo "command = \"$GREETER_DIR/frame-greeter-session\""
        echo "user = \"greeter\""
      } >>"$tmp"
      run sudo install -m 644 "$tmp" "$GREETD_CONFIG"
      rm -f "$tmp"
      ok "Wrote $GREETD_CONFIG (default_session → frameshell greeter)"
      printf '\n%sDone.%s The next boot shows the frameshell login screen. frame theme set … updates its colors too.\n\n' "$c_ok" "$c_reset"
      ;;
    remove)
      confirm "Back to the distro's greeter?" || exit 0
      step "greetd"
      if [[ -f $STATE_DIR/greetd-config.orig ]]; then
        run sudo install -m 644 "$STATE_DIR/greetd-config.orig" "$GREETD_CONFIG"
        ok "Restored $GREETD_CONFIG"
      else
        warn "No saved original config; edit $GREETD_CONFIG by hand"
      fi
      step "Greeter files"
      run sudo rm -rf "$GREETER_DIR"
      ok "Removed $GREETER_DIR"
      ;;
    *) die "Unknown login action: $action (install or remove)" ;;
  esac
}

cmd_grub() {
  local action=${1:-install}
  need_arch
  need_grub
  header
  case $action in
    install)
      info "Copies the frameshell theme ($(current_theme)) to $GRUB_THEME_DIR and sets GRUB_THEME (needs sudo)"
      confirm "Install the GRUB theme?" || exit 0
      step "Dependencies"
      install_deps ttf-jetbrains-mono
      grub_apply
      printf '\n%sDone.%s Reboot to see the new boot menu.\n\n' "$c_ok" "$c_reset"
      ;;
    remove)
      confirm "Remove the frameshell GRUB theme?" || exit 0
      step "GRUB config"
      # Only comment out our line; restoring the old file would drop later edits
      run sudo sed -i -E "s|^GRUB_THEME=\"$GRUB_THEME_DIR/theme.txt\"|#&|" "$GRUB_DEFAULT_FILE"
      ok "Commented out GRUB_THEME"
      step "Theme files"
      run sudo rm -rf "$GRUB_THEME_DIR"
      ok "Removed $GRUB_THEME_DIR"
      step "grub.cfg"
      run sudo grub-mkconfig -o /boot/grub/grub.cfg
      ok "Rebuilt /boot/grub/grub.cfg"
      [[ -f $STATE_DIR/grub-default.orig ]] && info "Your original /etc/default/grub is kept at $STATE_DIR/grub-default.orig"
      return 0
      ;;
    *) die "Unknown grub action: $action (install or remove)" ;;
  esac
}

# ── Theme ────────────────────────────────────────────────────
# themes/<name>.json holds a theme: the same color roles for all of them, the 16
# terminal colors and the fonts. themes/templates/<package>/<path> are the app files
# with placeholders like {{colors.primary}}, {{ansi.4}} or {{colors.bg|lighten:8|rgb}}.
# frame theme fills them in and writes <package>/<path>. Those outputs are git-ignored,
# so switching themes never shows up as a change in the repo; install and update
# write them before linking.

TEMPLATE_DIR="$REPO/themes/templates"
declare -A PALETTE=()

# Theme names, from the files in themes/
theme_ids() {
  find "$REPO/themes" -maxdepth 1 -name '*.json' -printf '%f\n' | sed 's/\.json$//' | sort
}

is_theme() {
  [[ -n $1 && -f $REPO/themes/$1.json ]]
}

# "name|description" lines for choose(), the default theme first
theme_choices() {
  local id desc
  for id in "$DEFAULT_THEME" $(theme_ids | grep -vx "$DEFAULT_THEME"); do
    desc=$(sed -n 's/.*"description": *"\([^"]*\)".*/\1/p' "$REPO/themes/$id.json" | head -n 1)
    echo "$id|$desc"
  done
}

save_theme() {
  if ((DRY_RUN)); then
    info "would remember theme $1 in $THEME_STATE"
    return 0
  fi
  mkdir -p "$STATE_DIR"
  echo "$1" >"$THEME_STATE"
}

# Flattens themes/<name>.json into PALETTE: colors.primary, ansi.4, fonts.mono, name, …
load_palette() {
  local id=$1 key value
  PALETTE=()
  while IFS='=' read -r key value; do
    PALETTE[$key]=$value
  done < <(jq -r 'paths(scalars) as $p | "\($p | map(tostring) | join("."))=\(getpath($p))"' "$REPO/themes/$id.json")
  [[ -n ${PALETTE[colors.primary]:-} ]] || die "themes/$id.json has no colors.primary"
  PALETTE[id]=$id
}

# mix_hex <#a> <#b> <percent>: a with percent of b mixed in
mix_hex() {
  local a=${1#\#} b=${2#\#} p=$3 i x y out="#"
  for i in 0 2 4; do
    x=$((16#${a:i:2}))
    y=$((16#${b:i:2}))
    out+=$(printf '%02x' $(((x * (100 - p) + y * p + 50) / 100)))
  done
  printf '%s' "$out"
}

# One filter step. Color steps: lighten:N, darken:N (N percent of white or black mixed in),
# mix:<key>:N (another palette color). Formats, last in a chain: bare (5d6fe8),
# rgb (93,111,232), argb (#ff5d6fe8), alpha:XX (#5d6fe8XX, XX in hex).
color_step() {
  local v=$1 f=$2 h n
  h=${v#\#}
  [[ $v =~ ^#[0-9a-fA-F]{6}$ ]] || return 1
  case $f in
    bare) printf '%s' "$h" ;;
    argb) printf '#ff%s' "$h" ;;
    rgb) printf '%d,%d,%d' "$((16#${h:0:2}))" "$((16#${h:2:2}))" "$((16#${h:4:2}))" ;;
    alpha:*)
      [[ ${f#alpha:} =~ ^[0-9a-fA-F]{2}$ ]] || return 1
      printf '%s%s' "$v" "${f#alpha:}" ;;
    lighten:* | darken:*)
      n=${f#*:}
      [[ $n =~ ^[0-9]+$ ]] && ((n <= 100)) || return 1
      if [[ $f == lighten:* ]]; then mix_hex "$v" "#ffffff" "$n"; else mix_hex "$v" "#000000" "$n"; fi ;;
    mix:*)
      local rest=${f#mix:} key
      key=${rest%:*}
      n=${rest##*:}
      [[ -n ${PALETTE[$key]+set} && $n =~ ^[0-9]+$ ]] && ((n <= 100)) || return 1
      mix_hex "$v" "${PALETTE[$key]}" "$n" ;;
    *) return 1 ;;
  esac
}

# apply_filters <value> <"|step|step">
apply_filters() {
  local value=$1 chain=$2 f
  local IFS='|'
  for f in $chain; do
    f=${f// /}
    [[ -z $f ]] && continue
    value=$(color_step "$value" "$f") || return 1
  done
  printf '%s' "$value"
}

# Prints a template with every {{key}} or {{key|step|step}} filled in
render_template() {
  local file=$1 line out match key chain value
  local re='\{\{ *([A-Za-z0-9_.]+) *((\| *[A-Za-z0-9:._]+ *)*)\}\}'
  while IFS= read -r line || [[ -n $line ]]; do
    out=""
    while [[ $line =~ $re ]]; do
      match=${BASH_REMATCH[0]} key=${BASH_REMATCH[1]} chain=${BASH_REMATCH[2]}
      if [[ -z ${PALETTE[$key]+set} ]]; then
        printf 'unknown key %s in %s\n' "$key" "${file#"$TEMPLATE_DIR"/}" >&2
        return 1
      fi
      if ! value=$(apply_filters "${PALETTE[$key]}" "$chain"); then
        printf 'bad filter "%s" on %s in %s\n' "$chain" "$key" "${file#"$TEMPLATE_DIR"/}" >&2
        return 1
      fi
      out+="${line%%"$match"*}$value"
      line=${line#*"$match"}
    done
    printf '%s\n' "$out$line"
  done <"$file"
}

# Template paths relative to themes/templates, e.g. zed/.config/zed/themes/frameshell.json
theme_templates() {
  [[ -d $TEMPLATE_DIR ]] || return 0
  (cd "$TEMPLATE_DIR" && find . -type f | sed 's|^\./||' | sort)
}

# theme_render <name> <check: 0|1> [quiet]: writes (or only compares) every output file
theme_render() {
  local id=$1 check=$2 quiet=${3:-}
  if ! command -v jq >/dev/null; then
    if ((DRY_RUN)); then
      info "would write the $id color files (needs jq)"
      return 0
    fi
    die "frame theme needs jq (pacman -S jq)"
  fi
  load_palette "$id"
  [[ -n $quiet ]] || step "Theme ${PALETTE[name]} (themes/$id.json)"

  local rel pkg tmp state mark color written=0 stale=0 total=0
  tmp="$(mktemp)"
  while IFS= read -r rel; do
    total=$((total + 1))
    pkg=${rel%%/*}
    if ! render_template "$TEMPLATE_DIR/$rel" >"$tmp"; then
      rm -f "$tmp"
      die "Could not render themes/templates/$rel"
    fi
    if [[ -f $REPO/$rel ]] && cmp -s "$tmp" "$REPO/$rel"; then
      state=unchanged color=$c_ok mark=✓
    elif ((check)); then
      state="out of date" color=$c_warn mark=! stale=$((stale + 1))
    else
      run mkdir -p "$(dirname "$REPO/$rel")"
      run cp "$tmp" "$REPO/$rel"
      state=written color=$c_warn mark=↻ written=$((written + 1))
    fi
    [[ -n $quiet ]] || printf '  %s%s%s %-11s %-50s %s%s%s\n' "$color" "$mark" "$c_reset" "$pkg" "${rel#*/}" "$c_muted" "$state" "$c_reset"
    # Outputs must stay out of git, or every theme switch would be a change in the repo
    if ((!check)) && [[ -d $REPO/.git ]] && command -v git >/dev/null \
      && ! git -C "$REPO" check-ignore -q -- "$rel" 2>/dev/null; then
      warn "$rel is not in .gitignore"
    fi
  done < <(theme_templates)
  rm -f "$tmp"

  if ((check)); then
    if ((stale)); then
      warn "$stale of $total files do not match themes/$id.json, run: frame theme"
      exit 1
    fi
    info "All $total files match themes/$id.json"
  elif [[ -n $quiet ]]; then
    ok "Theme ${PALETTE[name]}: $total color files, $written rewritten"
  else
    info "$written of $total files rewritten"
  fi
}

# What each app needs after its color files changed; only for linked packages
theme_reload() {
  step "Apps"
  local p
  for p in $(installed_packages); do
    case $p in
      quickshell) ok "Quickshell reloads on its own" ;;
      hypr)
        if command -v hyprctl >/dev/null && ((!DRY_RUN)); then
          hyprctl reload >/dev/null 2>&1 && ok "Hyprland window colors reloaded"
        fi
        ;;
      spicetify) post_spicetify ;;
      ghostty) info "Ghostty: new windows use the theme, open ones reload with Ctrl+Shift+," ;;
      fish) info "fish and Starship: new shells use the theme" ;;
      vencord) info "Vesktop: reload with Ctrl+R if the colors did not change on their own" ;;
      zed) ok "Zed reloads its theme on its own" ;;
      dolphin) info "Dolphin: restart it for the new colors" ;;
      zen) info "Zen: restart it for the new colors" ;;
    esac
  done
  if command -v curl >/dev/null && [[ -n $(goxlr_serial) ]]; then
    goxlr_lighting "${PALETTE[id]}" quiet
  fi
  if [[ -d $GRUB_THEME_DIR ]]; then
    info "Boot menu: run frame grub to give GRUB the new colors (needs sudo)"
  fi
  return 0
}

theme_list() {
  header
  step "Themes"
  local id cur desc swatch r h
  cur=$(current_theme)
  for id in $(theme_ids); do
    desc=$(sed -n 's/.*"description": *"\([^"]*\)".*/\1/p' "$REPO/themes/$id.json" | head -n 1)
    swatch=""
    if ((USE_COLOR)); then
      for r in bg surface2 primary secondary accent text; do
        h=$(theme_hex "$id" "$r")
        [[ -n $h ]] && swatch+="$(bg_hex "$h")  "
      done
      swatch+="$c_reset "
    fi
    if [[ $id == "$cur" ]]; then
      printf '  %s❯%s %s%-11s%s %s%s%s%s\n' "$c_primary" "$c_reset" "$c_bold" "$id" "$c_reset" "$swatch" "$c_muted" "$desc" "$c_reset"
    else
      printf '    %-11s %s%s%s%s\n' "$id" "$swatch" "$c_muted" "$desc" "$c_reset"
    fi
  done
  info "Switch with: frame theme set <name>"
}

theme_set() {
  local id=$1
  is_theme "$id" || die "Unknown theme: $id (available: $(theme_ids | tr '\n' ' '))"
  # Check before saving, so the saved theme never differs from the written files
  command -v jq >/dev/null || ((DRY_RUN)) || die "frame theme needs jq (pacman -S jq)"
  header
  save_theme "$id"
  theme_render "$id" 0
  theme_reload
  printf '\n%sDone.%s frameshell now uses %s.\n\n' "$c_ok" "$c_reset" "${PALETTE[name]:-$id}"
}

cmd_theme() {
  local action=${1:-}
  case $action in
    "")
      header
      theme_render "$(current_theme)" 0
      theme_reload
      ;;
    list | ls) theme_list ;;
    set | use)
      [[ -n ${2:-} ]] || die "Name a theme: frame theme set <name> (see: frame theme list)"
      theme_set "$2"
      ;;
    check)
      header
      theme_render "$(current_theme)" 1
      ;;
    *)
      # frame theme sakura works too
      if is_theme "$action"; then
        theme_set "$action"
      else
        die "Unknown theme action: $action (frame theme list | set <name> | check)"
      fi
      ;;
  esac
}

# ── Small PNGs for GRUB ──────────────────────────────────────
# GRUB draws the menu frame from 1px images. They only need one color each, so they
# are written here directly (stored deflate block, no compression) instead of
# depending on an image tool.

CRC_TABLE=()
crc_init() {
  local n c k
  ((${#CRC_TABLE[@]})) && return 0
  for ((n = 0; n < 256; n++)); do
    c=$n
    for ((k = 0; k < 8; k++)); do
      if ((c & 1)); then c=$((0xEDB88320 ^ (c >> 1))); else c=$((c >> 1)); fi
    done
    CRC_TABLE[n]=$c
  done
}

# CRC-32 of hex-encoded bytes, as 8 hex digits
crc32_hex() {
  local hex=$1 c=0xFFFFFFFF i
  crc_init
  for ((i = 0; i < ${#hex}; i += 2)); do
    c=$((CRC_TABLE[(c ^ 16#${hex:i:2}) & 0xFF] ^ (c >> 8)))
  done
  printf '%08x' $((c ^ 0xFFFFFFFF))
}

adler32_hex() {
  local hex=$1 a=1 b=0 i
  for ((i = 0; i < ${#hex}; i += 2)); do
    a=$(((a + 16#${hex:i:2}) % 65521))
    b=$(((b + a) % 65521))
  done
  printf '%04x%04x' "$b" "$a"
}

png_chunk() {
  local type=$1 data=$2
  printf '%08x%s%s%s' $((${#data} / 2)) "$type" "$data" "$(crc32_hex "$type$data")"
}

# png_solid <file> <width> <rrggbb>: one row of opaque pixels in one color
png_solid() {
  local file=$1 width=$2 color=$3 raw="00" i len zlib hex bytes=""
  if ((DRY_RUN)); then
    info "would draw ${file##*/} (${width}x1, #$color)"
    return 0
  fi
  for ((i = 0; i < width; i++)); do raw+="${color}ff"; done
  len=$((${#raw} / 2))
  # zlib header, one final stored block (LEN and its complement, little endian), Adler-32
  zlib="780101$(printf '%02x%02x%02x%02x' $((len & 255)) $((len >> 8)) $((~len & 255)) $(((~len >> 8) & 255)))$raw$(adler32_hex "$raw")"
  hex="89504e470d0a1a0a"
  hex+=$(png_chunk 49484452 "$(printf '%08x%08x' "$width" 1)0806000000")
  hex+=$(png_chunk 49444154 "$zlib")
  hex+=$(png_chunk 49454e44 "")
  for ((i = 0; i < ${#hex}; i += 2)); do bytes+="\\x${hex:i:2}"; done
  printf '%b' "$bytes" >"$file"
}

# ── Commands ─────────────────────────────────────────────────

# Hands everything to the wallpaper helper: frame wallpaper backend mpv, … set <file>, …
cmd_wallpaper() {
  local bin="$HOME/.local/bin/frame-wallpaper"
  [[ -x $bin ]] || bin="$REPO/wallpaper/.local/bin/frame-wallpaper"
  exec "$bin" "$@"
}

# Hands everything to the Spotify Web API helper: frame spotify login, … status, … logout
cmd_spotify() {
  local bin="$HOME/.local/bin/frame-spotify"
  [[ -x $bin ]] || bin="$REPO/spicetify/.local/bin/frame-spotify"
  exec "$bin" "$@"
}

# ── Setup ────────────────────────────────────────────────────

# Always part of frameshell; the rest is asked in the setup
CORE_PACKAGES=(ghostty fish starship fastfetch quickshell hypr wallpaper)
OPTIONAL_PACKAGES=(
  "spicetify|Spotify, themed, with search and controls in the launcher"
  "vencord|Vesktop (Discord), themed, with calls and DMs in the shell"
  "zed|Zed, the code editor"
  "dolphin|Dolphin, the file manager"
  "zen|Zen, the browser"
)
LAYOUT_STATE="$STATE_DIR/layout"

# Filled by setup_wizard, used by cmd_install
SETUP_PKGS=()
WANT_CLAUDE=0
WANT_GOXLR=0
PICKED_LAYOUT=""

# TC-Helicon GoXLR (1220:8fe0) or GoXLR Mini (1220:8fe4) on USB
goxlr_connected() {
  local d
  for d in /sys/bus/usb/devices/*; do
    [[ -r $d/idVendor && -r $d/idProduct ]] || continue
    [[ $(<"$d/idVendor") == 1220 && $(<"$d/idProduct") == 8fe[04] ]] && return 0
  done
  return 1
}

current_layout() {
  local mode=tiling
  [[ -f $LAYOUT_STATE ]] && read -r mode <"$LAYOUT_STATE"
  [[ $mode == canvas ]] && echo canvas || echo tiling
}

save_layout() {
  run mkdir -p "$STATE_DIR"
  if ((DRY_RUN)); then
    info "would write $1 to $LAYOUT_STATE"
  else
    echo "$1" >"$LAYOUT_STATE"
  fi
}

# frame install without packages: everything at once, or app by app
setup_wizard() {
  local mode o
  mode=$(choose "What should be set up?" \
    "full|everything: the shell plus Spotify, Vesktop, Zed, Dolphin, Zen and Claude Code" \
    "pick|the shell, then each app with a yes or no" \
    "shell|only the shell: terminal, prompt, bar, launcher, lockscreen, wallpapers")
  SETUP_PKGS=("${CORE_PACKAGES[@]}")
  case $mode in
    full)
      for o in "${OPTIONAL_PACKAGES[@]}"; do SETUP_PKGS+=("${o%%|*}"); done
      WANT_CLAUDE=1
      ;;
    pick)
      for o in "${OPTIONAL_PACKAGES[@]}"; do
        confirm "${o#*|}?" && SETUP_PKGS+=("${o%%|*}")
      done
      confirm "Claude Code (the claude command; the launcher's c asks it)?" && WANT_CLAUDE=1
      ;;
  esac
  command -v claude >/dev/null && WANT_CLAUDE=0

  # A connected GoXLR needs its utility for the faders and mutes in the shell
  if goxlr_connected && ! command -v goxlr-daemon >/dev/null; then
    ok "GoXLR found, GoXLR Utility will be installed"
    WANT_GOXLR=1
  fi

  if [[ ! -f $LAYOUT_STATE ]]; then
    PICKED_LAYOUT=$(choose "Window layout? (switch any time: frame layout tiling|canvas)" \
      "tiling|Hyprland's tiling with workspaces, as usual" \
      "canvas|infinite canvas: windows float on an endless plane, the bar shows a minimap")
  fi
}

# Anthropic's own installer puts claude into ~/.local/bin and keeps it updated
install_claude() {
  step "Claude Code"
  if command -v claude >/dev/null; then
    ok "claude already installed"
    return 0
  fi
  if run bash -c 'curl -fsSL https://claude.ai/install.sh | bash'; then
    ok "Claude Code installed; run claude once to sign in, then the launcher's c works"
  else
    warn "Claude Code install failed; try again with: curl -fsSL https://claude.ai/install.sh | bash"
  fi
}

# The package came with the dependencies; start the daemon now, Hyprland starts it from then on
setup_goxlr() {
  step "GoXLR"
  if ! command -v goxlr-daemon >/dev/null && ((!DRY_RUN)); then
    warn "goxlr-daemon not found after the install; the shell's GoXLR panel stays empty"
    return 0
  fi
  if command -v pgrep >/dev/null && pgrep -x goxlr-daemon >/dev/null; then
    ok "GoXLR Utility is running"
  elif ((DRY_RUN)); then
    info "would start goxlr-daemon"
  else
    (goxlr-daemon >/dev/null 2>&1 &)
    ok "GoXLR Utility started (settings: http://localhost:14564)"
  fi
  info "Unplug and replug the GoXLR once if it does not show up (new udev rules)"
}

# frame layout [tiling|canvas]: switch between Hyprland's tiling and the infinite canvas
cmd_layout() {
  local want=${1:-} now
  now=$(current_layout)
  if [[ -z $want ]]; then
    info "Layout: $now (frame layout tiling|canvas)"
    return 0
  fi
  [[ $want == tiling || $want == canvas ]] || die "Unknown layout: $want (tiling or canvas)"
  if [[ $want == "$now" ]]; then
    ok "Already $now"
    return 0
  fi
  # Leaving the canvas: big windows tile again before the canvas code is gone
  if [[ $now == canvas ]] && command -v hyprctl >/dev/null; then
    run_quiet hyprctl eval 'frame_canvas.release()' || true
  fi
  save_layout "$want"
  if command -v hyprctl >/dev/null; then
    run_quiet hyprctl reload || true
  fi
  ok "Layout: $want"
  [[ $want == canvas ]] && info "Super+Ctrl+arrows looks around, Super+Alt+arrows jumps between windows, hold Super for all keys"
  return 0
}

cmd_install() {
  need_arch
  local pkgs=("$@") p extra=()

  header
  if ((${#pkgs[@]} == 0)); then
    setup_wizard
    pkgs=("${SETUP_PKGS[@]}")
  fi
  # spicetify themes a Spotify that has to be there; the AUR one lives in /opt/spotify
  if [[ " ${pkgs[*]} " == *" spicetify "* ]] && ! command -v spotify >/dev/null && ! command -v spotify-launcher >/dev/null; then
    extra+=(spotify)
  fi
  ((WANT_GOXLR)) && extra+=(goxlr-utility)

  info "Packages: ${pkgs[*]}"
  ((${#extra[@]})) && info "Apps: ${extra[*]}"
  ((WANT_CLAUDE)) && info "Claude Code: yes"
  [[ -n $PICKED_LAYOUT ]] && info "Layout: $PICKED_LAYOUT"
  ((DRY_RUN)) && info "Dry run, nothing will be changed"
  confirm "Install and link these?" || exit 0

  step "Dependencies"
  mapfile -t deps < <(deps_of "${pkgs[@]}")
  install_deps stow jq "${deps[@]}" "${extra[@]}"
  [[ -n $PICKED_LAYOUT ]] && save_layout "$PICKED_LAYOUT"

  # The color files are generated, so they exist before anything is linked
  step "Theme"
  if [[ ! -f $THEME_STATE ]]; then
    local picked choices=()
    mapfile -t choices < <(theme_choices)
    picked=$(choose "Which theme? (switch any time: frame theme set <name>)" "${choices[@]}")
    save_theme "$picked"
  fi
  theme_render "$(current_theme)" 0 quiet

  local backup
  backup="$(new_backup_dir install)"
  for p in "${pkgs[@]}"; do
    step "$p"
    link_pkg "$p" "$backup"
    run_post "$p"
  done

  ((WANT_CLAUDE)) && install_claude
  ((WANT_GOXLR)) && setup_goxlr

  step "frame command"
  link_self
  [[ -d $backup ]] && info "Old configs were moved to $backup"
  printf '\n%sDone.%s Open a new terminal to see the changes.\n\n' "$c_ok" "$c_reset"
}

cmd_update() {
  need_arch
  local requested=("$@") pkgs=("$@")
  ((${#pkgs[@]})) || mapfile -t pkgs < <(installed_packages)
  ((${#pkgs[@]})) || die "Nothing installed yet, run: frame install"

  header
  if ((!NO_PULL)); then
    step "frameshell"
    [[ -z $(git -C "$REPO" status --porcelain --untracked-files=no) ]] \
      || die "The repo has local changes. Commit or stash them first (cd $REPO)."
    local before after
    before=$(git -C "$REPO" rev-parse HEAD)
    run git -C "$REPO" pull --ff-only
    after=$(git -C "$REPO" rev-parse HEAD)
    if [[ $before == "$after" ]]; then
      ok "Already up to date"
    else
      ok "Updated $(git -C "$REPO" rev-parse --short "$before") → $(git -C "$REPO" rev-parse --short "$after")"
      # Continue with the freshly pulled version of this script
      local flags=(--no-pull)
      ((ASSUME_YES)) && flags+=(-y)
      exec "$REPO/frame" update "${flags[@]}" "${requested[@]}"
    fi
  fi

  step "Backup"
  snapshot_pkgs update "${pkgs[@]}"

  # Templates may have changed with the pull
  step "Theme"
  theme_render "$(current_theme)" 0 quiet

  step "Dependencies"
  mapfile -t deps < <(deps_of "${pkgs[@]}")
  install_deps "${deps[@]}"

  local p
  for p in "${pkgs[@]}"; do
    step "$p"
    link_pkg "$p" "$LAST_BACKUP"
    run_post "$p"
  done

  # A plain `frame update` also refreshes an installed GRUB theme
  if ((${#requested[@]} == 0)) && [[ -d $GRUB_THEME_DIR ]] && command -v grub-mkconfig >/dev/null; then
    grub_apply
  fi
  printf '\n%sDone.%s\n\n' "$c_ok" "$c_reset"
}

cmd_remove() {
  (($#)) || die "Name the packages to remove, e.g.: frame remove spicetify"
  command -v stow >/dev/null || ((DRY_RUN)) || die "stow is not installed"
  local p
  for p in "$@"; do
    step "$p"
    if [[ -z $(pkg_root "$p") ]]; then
      info "Nothing linked"
      continue
    fi
    stow_pkg -D "$p"
    ok "Config unlinked"
  done
  info "Backups of your old configs: frame restore"
}

cmd_backup() {
  local pkgs=("$@")
  ((${#pkgs[@]})) || pkgs=("${PACKAGES[@]}")
  header
  step "Backup"
  snapshot_pkgs manual "${pkgs[@]}"
  [[ -n $LAST_BACKUP && -d $LAST_BACKUP ]] && info "$LAST_BACKUP"
  return 0
}

cmd_restore() {
  local name=${1:-} b
  header

  if [[ -z $name ]]; then
    step "Backups"
    local found=0 count
    while IFS= read -r b; do
      found=1
      count=$(find "$BACKUP_ROOT/$b" -type f | wc -l)
      printf '  %-34s %s%s files%s\n' "$b" "$c_muted" "${count// /}" "$c_reset"
    done < <(list_backups)
    if ((found)); then
      info "Put one back with: frame restore <name>   (or: frame restore latest)"
    else
      info "No backups yet. Create one with: frame backup"
    fi
    return 0
  fi

  [[ $name == latest ]] && name=$(list_backups | head -n 1)
  local src="$BACKUP_ROOT/$name"
  [[ -n $name && -d $src ]] || die "No backup named ${1} (list them with: frame restore)"

  local files=() f
  while IFS= read -r f; do files+=("$f"); done < <(cd "$src" && find . -type f | sed 's|^\./||' | sort)
  ((${#files[@]})) || die "Backup $name is empty"

  step "Restore $name"
  for f in "${files[@]}"; do info "~/$f"; done
  confirm "Put these ${#files[@]} files back? The current state is backed up first." || exit 0

  step "Safety backup"
  snapshot_files before-restore "${files[@]}"

  step "Restoring"
  for f in "${files[@]}"; do
    run mkdir -p "$HOME/$(dirname "$f")"
    # Drop frame's symlink first so the copy does not land in the repo
    [[ -L $HOME/$f ]] && run rm "$HOME/$f"
    run cp "$src/$f" "$HOME/$f"
  done
  ok "Restored $name"
  info "Restored files are plain copies. To link a package again: frame install <package>"
}

cmd_status() {
  header
  printf '  %s%-12s %-10s %s%s\n' "$c_muted" "PACKAGE" "CONFIG" "DEPENDENCIES" "$c_reset"
  local p state d missing color
  for p in "${PACKAGES[@]}"; do
    state=$(link_state "$p")
    missing=()
    for d in ${DEPS[$p]}; do has_pkg "$d" || missing+=("$d"); done
    case $state in
      linked) color=$c_ok ;;
      partial) color=$c_warn ;;
      *) color=$c_muted ;;
    esac
    if ((${#missing[@]})); then
      printf '  %-12s %s%-10s%s %smissing: %s%s\n' "$p" "$color" "$state" "$c_reset" "$c_danger" "${missing[*]}" "$c_reset"
    else
      printf '  %-12s %s%-10s%s %sok%s\n' "$p" "$color" "$state" "$c_reset" "$c_ok" "$c_reset"
    fi
  done

  step "Checks"
  ok "Theme $(current_theme) (frame theme list)"
  ok "Layout $(current_layout) (frame layout tiling|canvas)"
  if goxlr_connected && ! command -v goxlr-daemon >/dev/null; then
    warn "A GoXLR is connected but GoXLR Utility is missing (paru -S goxlr-utility)"
  fi
  command -v pacman >/dev/null || warn "pacman not found, dependency checks are skipped"
  command -v stow >/dev/null && ok "stow installed" || warn "stow missing (frame install takes care of it)"

  if command -v fc-list >/dev/null; then
    fc-list | grep -qiE "jetbrains ?mono" && ok "Font JetBrains Mono installed" \
      || warn "Font JetBrains Mono missing, Spotify, Vesktop and GRUB need it (pacman -S ttf-jetbrains-mono)"
  fi

  [[ -f $REPO/assets/logo.png ]] && ok "fastfetch logo found" \
    || warn "No fastfetch logo at assets/logo.png"

  command -v spotify >/dev/null || command -v spotify-launcher >/dev/null \
    || warn "Spotify not found, the spicetify theme needs it"

  if grep -qs fastfetch /usr/share/cachyos-fish-config/cachyos-config.fish; then
    warn "CachyOS's fish config runs fastfetch too, you may see it twice"
    info "Fix: remove the cachyos-config line in ~/.config/fish/config.fish, or keep theirs and drop fish_greeting in conf.d/frameshell.fish"
  fi

  [[ :$PATH: == *":$HOME/.local/bin:"* ]] || warn "~/.local/bin is not in PATH, the frame command will not be found"

  if [[ -f /boot/grub/grub.cfg ]]; then
    [[ -d $GRUB_THEME_DIR ]] && ok "GRUB theme installed" || info "GRUB theme not installed (frame grub)"
  fi

  local conflicts
  conflicts=$(notification_conflicts | tr '\n' ' ')
  if [[ -n ${conflicts// /} ]]; then
    warn "Other notification daemons active: ${conflicts}(frame install quickshell turns them off)"
  fi

  if [[ -d $VENCORD_SRC/dist ]]; then
    ok "Vencord build with ShellBridge ($(cat "$STATE_DIR/vencord-build" 2>/dev/null || echo "unknown version"))"
  fi

  local backups
  backups=$(list_backups | wc -l)
  info "${backups// /} backups in $BACKUP_ROOT (frame restore)"
  echo
}

# ── Main ─────────────────────────────────────────────────────

main() {
  local cmd=help args=() a
  if (($#)); then cmd=$1; shift; fi
  while (($#)); do
    case $1 in
      -n | --dry-run) DRY_RUN=1 ;;
      -y | --yes) ASSUME_YES=1 ;;
      --no-pull) NO_PULL=1 ;;
      -h | --help) cmd=help ;;
      -*) die "Unknown option: $1" ;;
      *) args+=("$1") ;;
    esac
    shift
  done

  case $cmd in
    install | i | update | up | remove | rm | uninstall | backup)
      for a in "${args[@]}"; do
        is_package "$a" || die "Unknown package: $a (available: ${PACKAGES[*]})"
      done
      ;;
  esac

  case $cmd in
    install | i) cmd_install "${args[@]}" ;;
    update | up) cmd_update "${args[@]}" ;;
    remove | rm | uninstall) cmd_remove "${args[@]}" ;;
    backup) cmd_backup "${args[@]}" ;;
    restore) cmd_restore "${args[@]}" ;;
    grub) cmd_grub "${args[@]}" ;;
    goxlr) cmd_goxlr "${args[@]}" ;;
    login) cmd_login "${args[@]}" ;;
    theme) cmd_theme "${args[@]}" ;;
    wallpaper | wp) cmd_wallpaper "${args[@]}" ;;
    spotify) cmd_spotify "${args[@]}" ;;
    layout) cmd_layout "${args[@]}" ;;
    status | st | doctor) cmd_status ;;
    help) usage ;;
    *) die "Unknown command: $cmd (try: frame help)" ;;
  esac
}

# Kept on one line: update may replace this file while it runs
main "$@"; exit $?
