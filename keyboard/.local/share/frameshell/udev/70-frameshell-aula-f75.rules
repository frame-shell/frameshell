# AULA F75: hidraw access for frame-keyboard without root, for whoever sits at the seat.
# `frame install keyboard` copies it to /etc/udev/rules.d (udev does not follow it into $HOME);
# then unplug and plug the keyboard (or the dongle) once.

# Keyboard on the USB cable (SinoWealth SH68F90, "BYK916")
KERNEL=="hidraw*", ATTRS{idVendor}=="258a", ATTRS{idProduct}=="010c", TAG+="uaccess"
# 2.4 GHz dongle (Beken BK3632); frame-keyboard only lists it for now
KERNEL=="hidraw*", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="fa09", TAG+="uaccess"
