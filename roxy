#!/usr/bin/env bash
# roxy – install and manage roxy-dots
#
#   roxy install [package...]   install dependencies and link configs (default: all)
#   roxy update  [package...]   git pull, back up, relink and re-apply app themes
#   roxy remove  <package...>   unlink configs (dependencies stay installed)
#   roxy backup  [package...]   snapshot the current configs and app settings
#   roxy restore [name|latest]  list backups, or put one back
#   roxy grub [install|remove]  theme the GRUB boot menu (copies to /boot, needs sudo)
#   roxy status                 show what is linked and what is missing
#
# Options: -n/--dry-run (print what would happen), -y/--yes (no questions)

set -euo pipefail

REPO="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/roxy-dots"
BACKUP_ROOT="$STATE_DIR/backup"
GRUB_THEME_DIR="/boot/grub/themes/roxy"
GRUB_DEFAULT_FILE="/etc/default/grub"
VENCORD_SRC="${XDG_DATA_HOME:-$HOME/.local/share}/roxy-dots/vencord"

PACKAGES=(ghostty fish starship fastfetch spicetify vencord quickshell hypr)

# Distro packages each config needs; AUR ones go through paru/yay
declare -A DEPS=(
  [ghostty]="ghostty"
  [fish]="fish"
  [starship]="starship"
  [fastfetch]="fastfetch chafa"
  [spicetify]="spicetify-cli ttf-jetbrains-mono"
  [vencord]="vesktop ttf-jetbrains-mono jq git nodejs pnpm"
  [quickshell]="quickshell ttf-jetbrains-mono ttf-jetbrains-mono-nerd wl-clipboard libpulse pciutils"
  [hypr]="hypridle"
)

# App files outside the repo that roxy touches or that belong in a backup
declare -A EXTRAS=(
  [fish]=".config/fish/config.fish"
  [spicetify]=".config/spicetify/config-xpui.ini"
  [vencord]=".config/vesktop/settings/settings.json"
  [hypr]=".config/hypr/hyprland.conf"
)

DRY_RUN=0
ASSUME_YES=0
NO_PULL=0
LAST_BACKUP=""

# ── Output ───────────────────────────────────────────────────

# Colors on a terminal; FORCE_COLOR keeps them in logs, NO_COLOR turns them off
if [[ -n ${FORCE_COLOR:-} || ( -t 1 && -z ${NO_COLOR:-} ) ]]; then
  c_text=$'\e[38;2;225;228;255m'
  c_primary=$'\e[38;2;93;111;232m'
  c_secondary=$'\e[38;2;147;164;247m'
  c_muted=$'\e[38;2;128;134;184m'
  c_ok=$'\e[38;2;110;224;182m'
  c_warn=$'\e[38;2;242;201;125m'
  c_danger=$'\e[38;2;255;107;154m'
  c_bold=$'\e[1m'
  c_reset=$'\e[0m'
else
  c_text='' c_primary='' c_secondary='' c_muted='' c_ok='' c_warn='' c_danger='' c_bold='' c_reset=''
fi

header() {
  printf '\n  %s%sroxy%s  %sdotfiles · CachyOS · Hyprland%s\n\n' \
    "$c_bold" "$c_primary" "$c_reset" "$c_muted" "$c_reset"
}

step() { printf '\n%s●%s %s%s%s\n' "$c_primary" "$c_reset" "$c_bold" "$*" "$c_reset"; }
info() { printf '  %s%s%s\n' "$c_muted" "$*" "$c_reset"; }
ok()   { printf '  %s✓%s %s\n' "$c_ok" "$c_reset" "$*"; }
warn() { printf '  %s!%s %s\n' "$c_warn" "$c_reset" "$*"; }
die()  { printf '%s✗%s %s\n' "$c_danger" "$c_reset" "$*" >&2; exit 1; }

# Runs a command, or only prints it in dry-run mode
run() {
  if ((DRY_RUN)); then
    printf '  %swould run:%s %s\n' "$c_muted" "$c_reset" "$*"
    return 0
  fi
  "$@"
}

# Like run, but hides the command's own output
run_quiet() {
  if ((DRY_RUN)); then
    run "$@"
    return 0
  fi
  "$@" >/dev/null 2>&1
}

confirm() {
  ((ASSUME_YES)) && return 0
  local answer=""
  printf '  %s [Y/n] ' "$1"
  read -r answer || true
  # Typed answers are already on screen; piped ones are echoed so logs read right
  [[ -t 0 ]] || printf '%s\n' "${answer:-y}"
  [[ -z $answer || $answer =~ ^[YyJj] ]]
}

usage() {
  header
  cat <<EOF
  ${c_bold}Usage${c_reset}  roxy <command> [package...] [options]

  ${c_bold}Commands${c_reset}
    install [pkg...]      install dependencies and link configs (default: all)
    update  [pkg...]      git pull, back up, relink and re-apply app themes
                          (run "roxy update spicetify" after a Spotify update)
    remove  <pkg...>      unlink configs, dependencies stay installed
    backup  [pkg...]      snapshot the current configs and app settings
    restore [name|latest] list backups, or put one back
    grub [install|remove] theme the GRUB boot menu (copies to /boot, needs sudo)
    status                show what is linked and what is missing

  ${c_bold}Options${c_reset}
    -n, --dry-run         print what would happen, change nothing
    -y, --yes             do not ask for confirmation

  ${c_bold}Packages${c_reset}  ${PACKAGES[*]}

EOF
}

# ── Helpers ──────────────────────────────────────────────────

is_package() {
  local p
  for p in "${PACKAGES[@]}"; do [[ $p == "$1" ]] && return 0; done
  return 1
}

need_arch() {
  command -v pacman >/dev/null || die "roxy needs an Arch-based system (pacman not found)."
}

has_pkg() {
  command -v pacman >/dev/null && pacman -Qq "$1" &>/dev/null
}

aur_helper() {
  local h
  for h in paru yay; do
    command -v "$h" >/dev/null && { echo "$h"; return 0; }
  done
  return 0
}

deps_of() {
  local p d
  for p in "$@"; do
    for d in ${DEPS[$p]}; do echo "$d"; done
  done
}

install_deps() {
  local missing=() p helper
  # Several packages need the same fonts; ask for each package once
  for p in "$@"; do
    [[ " ${missing[*]} " == *" $p "* ]] && continue
    has_pkg "$p" || missing+=("$p")
  done
  if ((${#missing[@]} == 0)); then
    ok "All dependencies already installed"
    return 0
  fi
  info "Missing: ${missing[*]}"

  local noconfirm=()
  ((ASSUME_YES)) && noconfirm=(--noconfirm)
  helper="$(aur_helper)"
  if [[ -n $helper ]]; then
    run "$helper" -S --needed "${noconfirm[@]}" "${missing[@]}"
  else
    warn "No AUR helper (paru/yay) found, AUR packages like spicetify-cli will fail"
    run sudo pacman -S --needed "${noconfirm[@]}" "${missing[@]}"
  fi
}

# Files of a package, relative to the package root (= relative to $HOME)
pkg_files() {
  (cd "$REPO/$1" && find . \( -type f -o -type l \) | sed 's|^\./||' | sort)
}

# Repo files plus the app files listed in EXTRAS
managed_files() {
  pkg_files "$1"
  local extra
  for extra in ${EXTRAS[$1]:-}; do echo "$extra"; done
}

# Prints linked, partial or missing
link_state() {
  local pkg=$1 f total=0 linked=0
  while IFS= read -r f; do
    total=$((total + 1))
    if [[ -L $HOME/$f && "$(readlink -f "$HOME/$f")" == "$REPO/$pkg/$f" ]]; then
      linked=$((linked + 1))
    fi
  done < <(pkg_files "$pkg")
  if ((total > 0 && linked == total)); then echo linked
  elif ((linked > 0)); then echo partial
  else echo missing
  fi
}

installed_packages() {
  local p
  for p in "${PACKAGES[@]}"; do
    [[ $(link_state "$p") == missing ]] || echo "$p"
  done
}

new_backup_dir() {
  echo "$BACKUP_ROOT/$(date +%Y%m%d-%H%M%S)-$1"
}

# Copies files (relative to $HOME, symlinks resolved) into a new backup
snapshot_files() {
  local reason=$1 f n=0
  shift
  LAST_BACKUP="$(new_backup_dir "$reason")"
  for f in "$@"; do
    [[ -e $HOME/$f ]] || continue
    run mkdir -p "$LAST_BACKUP/$(dirname "$f")"
    run cp -L "$HOME/$f" "$LAST_BACKUP/$f"
    n=$((n + 1))
  done
  if ((n)); then ok "Backup $(basename "$LAST_BACKUP") ($n files)"; else info "Nothing to back up"; fi
}

snapshot_pkgs() {
  local reason=$1 p f files=()
  shift
  for p in "$@"; do
    while IFS= read -r f; do files+=("$f"); done < <(managed_files "$p")
  done
  snapshot_files "$reason" "${files[@]}"
}

# Moves existing files that would block stow into the backup folder
backup_conflicts() {
  local pkg=$1 dest=$2 f target
  while IFS= read -r f; do
    target="$HOME/$f"
    [[ -e $target || -L $target ]] || continue
    [[ "$(readlink -f "$target")" == "$REPO/$pkg/$f" ]] && continue
    warn "Backing up existing ~/$f"
    run mkdir -p "$dest/$(dirname "$f")"
    run mv "$target" "$dest/$f"
  done < <(pkg_files "$pkg")
}

# --no-folding links single files, so apps never write into the repo
stow_pkg() {
  run stow --no-folding -d "$REPO" -t "$HOME" "$@"
}

# Backup folder names, newest first
list_backups() {
  [[ -d $BACKUP_ROOT ]] || return 0
  find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort -r
}

link_self() {
  local bin="$HOME/.local/bin/roxy"
  [[ "$(readlink -f "$bin" 2>/dev/null)" == "$REPO/roxy" ]] && return 0
  run mkdir -p "$HOME/.local/bin"
  run ln -sf "$REPO/roxy" "$bin"
  ok "roxy is now available as a command (~/.local/bin/roxy)"
}

run_post() {
  if declare -F "post_$1" >/dev/null; then "post_$1"; fi
}

# ── Per-package follow-up steps (also run by update) ─────────

post_fish() {
  if [[ ${SHELL##*/} != fish ]]; then
    info "fish is not your login shell. To change it: chsh -s $(command -v fish || echo /usr/bin/fish)"
  fi
}

post_fastfetch() {
  if [[ ! -f $REPO/assets/roxy.png ]]; then
    warn "No logo at assets/roxy.png, fastfetch shows the distro logo instead"
    info "Put a PNG of your choice there (the folder is git-ignored)"
  fi
}

# Spotify updates wipe spicetify's changes, so this runs on every update
post_spicetify() {
  if ! command -v spicetify >/dev/null && ((!DRY_RUN)); then
    warn "spicetify not found, skipping theme activation"
    return 0
  fi
  run spicetify config current_theme Roxy color_scheme Roxy

  # apply fails on a fresh install or after a Spotify update; a new backup fixes both
  # The quiet first try avoids spicetify's "you haven't backed up" error on a fresh install
  if run_quiet spicetify apply || run spicetify backup apply; then
    ok "Spotify theme applied"
  else
    warn "spicetify failed. Open Spotify once, log in, then run: roxy update spicetify"
    info "Still broken after a Spotify update? Try: spicetify restore backup apply"
    info "Spotify from the AUR may need write access: https://spicetify.app/docs/advanced-usage/installation#spotify-installed-from-aur"
  fi
}

# jq in place: json_edit <file> [jq options…] <filter>
json_edit() {
  local file=$1 tmp
  shift
  tmp="$(mktemp)"
  jq "$@" "$file" >"$tmp" && mv "$tmp" "$file"
}

# ── Vencord build with the ShellBridge plugin ────────────────
# Vesktop ships its own Vencord, but user plugins need a self-built one. roxy keeps a
# clone in ~/.local/share/roxy-dots/vencord and rebuilds only when Vencord or the
# plugin changed.

vencord_plugin_hash() {
  (cd "$REPO/vencord/plugins" && find shellBridge -type f -print0 | sort -z | xargs -0 sha1sum) | sha1sum | cut -c1-12
}

vencord_build() {
  step "Vencord with ShellBridge"
  if [[ -d $VENCORD_SRC/.git ]]; then
    run git -C "$VENCORD_SRC" pull --ff-only --quiet || warn "Could not update Vencord, building the version that is there"
  else
    info "Getting Vencord (first time only)"
    run mkdir -p "$(dirname "$VENCORD_SRC")"
    run git clone --depth 1 --quiet https://github.com/Vendicated/Vencord.git "$VENCORD_SRC"
  fi

  local marker="$STATE_DIR/vencord-build" wanted=""
  [[ -d $VENCORD_SRC/.git ]] && wanted="$(git -C "$VENCORD_SRC" rev-parse --short HEAD)-$(vencord_plugin_hash)"
  if [[ -n $wanted && -d $VENCORD_SRC/dist && -f $marker && "$(cat "$marker")" == "$wanted" ]]; then
    ok "Vencord build up to date"
    return 0
  fi

  run rm -rf "$VENCORD_SRC/src/userplugins/shellBridge"
  run mkdir -p "$VENCORD_SRC/src/userplugins"
  run cp -r "$REPO/vencord/plugins/shellBridge" "$VENCORD_SRC/src/userplugins/shellBridge"
  info "Building Vencord, this takes about a minute"
  if run pnpm -C "$VENCORD_SRC" install --frozen-lockfile --silent && run pnpm -C "$VENCORD_SRC" build; then
    if ((!DRY_RUN)); then
      mkdir -p "$STATE_DIR"
      echo "$wanted" >"$marker"
    fi
    ok "Vencord built with ShellBridge"
  else
    warn "Vencord build failed, Vesktop keeps its own Vencord (the theme still works)"
    return 1
  fi
}

# Builds Vencord with ShellBridge, points Vesktop at it and turns on theme and plugin.
# Vesktop has to be closed while its settings are written, otherwise it writes its own
# copy back on exit.
post_vencord() {
  local built=0
  if command -v pnpm >/dev/null || ((DRY_RUN)); then
    vencord_build && built=1
  else
    warn "pnpm not found, skipping the ShellBridge plugin (the theme still works)"
  fi

  local vesktop="$HOME/.config/vesktop/settings.json"
  local vencord="$HOME/.config/vesktop/settings/settings.json"
  if [[ ! -f $vencord ]]; then
    info "Start Vesktop once, close it, then run: roxy update vencord"
    return 0
  fi
  if command -v pgrep >/dev/null && pgrep -fi vesktop >/dev/null; then
    warn "Vesktop is running. Close it and run: roxy update vencord"
    return 0
  fi
  if ((DRY_RUN)); then
    info "would enable the theme and ShellBridge in $vencord"
    info "would set the Vencord location in $vesktop to $VENCORD_SRC/dist"
    return 0
  fi
  if ! command -v jq >/dev/null; then
    warn "jq not found, enable it by hand: Settings → Themes → Roxy, Plugins → ShellBridge"
    return 0
  fi

  json_edit "$vencord" '.enabledThemes = ((.enabledThemes // []) + ["roxy.theme.css"] | unique)'
  ok "Theme enabled"
  if ((built)) || [[ -d $VENCORD_SRC/dist ]]; then
    json_edit "$vencord" '.plugins.ShellBridge.enabled = true'
    [[ -f $vesktop ]] || echo '{}' >"$vesktop"
    # Vesktop's "Vencord location": the dist folder of the build
    json_edit "$vesktop" --arg dir "$VENCORD_SRC/dist" '.vencordDir = $dir'
    ok "ShellBridge enabled, Vesktop uses the roxy Vencord build"
    info "Start Vesktop to load it"
  fi
  return 0
}

# ── Notification daemons ─────────────────────────────────────
# Only one program can own the notification service on D-Bus. mako, dunst or
# swaync would take the notifications away from the shell.

notification_conflicts() {
  local d
  for d in mako dunst swaync; do
    if { command -v pgrep >/dev/null && pgrep -x "$d" >/dev/null; } \
      || systemctl --user is-enabled "$d.service" >/dev/null 2>&1 \
      || grep -qsE "^[[:space:]]*exec(-once)?[[:space:]]*=.*\b$d\b" "$HOME"/.config/hypr/*.conf; then
      echo "$d"
    fi
  done
  return 0
}

# Stops them, disables their user services and comments out their exec-once lines
disable_notification_daemons() {
  local d f files=()
  for f in "$HOME"/.config/hypr/*.conf; do
    [[ -f $f && ! -L $f ]] && files+=("${f#"$HOME"/}")
  done
  snapshot_files notification-daemons "${files[@]}"
  for d in "$@"; do
    if systemctl --user is-enabled "$d.service" >/dev/null 2>&1; then
      run systemctl --user disable --now "$d.service" || true
    fi
    if command -v pkill >/dev/null; then
      run pkill -x "$d" || true
    fi
    for f in "${files[@]}"; do
      run sed -i -E "s|^([[:space:]]*exec(-once)?[[:space:]]*=.*\\b$d\\b.*)|# roxy: \\1|" "$HOME/$f"
    done
  done
  ok "Turned off: $* (roxy restore brings them back)"
}

post_quickshell() {
  local found=()
  mapfile -t found < <(notification_conflicts)
  if ((${#found[@]})); then
    warn "Other notification daemons found: ${found[*]}"
    info "Only one program can show notifications; for the shell's popups they have to go"
    if confirm "Turn them off?"; then
      disable_notification_daemons "${found[@]}"
    else
      info "Left them on; notifications go to ${found[0]} instead of the shell"
    fi
  fi
  info "Quickshell reloads on its own. Test the lockscreen with: qs ipc call lock lock"
  if command -v pgrep >/dev/null && ! pgrep -x qs >/dev/null && ! pgrep -x quickshell >/dev/null; then
    info "Quickshell is not running yet; start it with: qs -d (or log in again)"
  fi
  return 0
}

# Hooks roxy/shell.conf into the user's own hyprland.conf instead of owning it
post_hypr() {
  local conf="$HOME/.config/hypr/hyprland.conf"
  local line="source = ~/.config/hypr/roxy/shell.conf"
  local old_line="source = ~/.config/hypr/roxy/lock.conf"
  if [[ ! -f $conf ]]; then
    warn "No ~/.config/hypr/hyprland.conf found. Add this line to your Hyprland config:"
    info "$line"
    return 0
  fi
  if grep -qF "$line" "$conf"; then
    ok "hyprland.conf already sources roxy/shell.conf"
  elif grep -qF "$old_line" "$conf"; then
    # Older roxy versions used roxy/lock.conf
    snapshot_files hyprland-conf ".config/hypr/hyprland.conf"
    run sed -i "s|$old_line|$line|" "$conf"
    ok "Updated hyprland.conf: roxy/lock.conf → roxy/shell.conf"
  else
    snapshot_files hyprland-conf ".config/hypr/hyprland.conf"
    if ((DRY_RUN)); then
      info "would append to $conf: $line"
    else
      printf '\n# roxy: Quickshell keybinds, idle and autostart\n%s\n' "$line" >>"$conf"
      ok "Added to hyprland.conf: $line"
    fi
  fi
  info "If your config already binds SUPER+L or SUPER+SPACE, or starts hypridle, remove those lines to avoid doubles"
  if command -v hyprctl >/dev/null && ((!DRY_RUN)); then
    hyprctl reload >/dev/null && ok "Hyprland reloaded"
  fi
  return 0
}

# ── GRUB ─────────────────────────────────────────────────────
# GRUB reads its theme from /boot before /home exists, so the theme is
# copied there instead of linked.

need_grub() {
  [[ -f /boot/grub/grub.cfg ]] && command -v grub-mkconfig >/dev/null \
    || die "This system does not boot with GRUB (no /boot/grub/grub.cfg)."
}

# Path of a JetBrains Mono TTF in the given style (Regular, Bold)
grub_font_src() {
  local style=$1 f
  for f in /usr/share/fonts/TTF/JetBrainsMono-"$style".ttf \
           /usr/share/fonts/truetype/jetbrains-mono/JetBrainsMono-"$style".ttf; do
    [[ -f $f ]] && { echo "$f"; return 0; }
  done
  f=$(fc-match -f '%{file}' "JetBrains Mono:style=$style" 2>/dev/null || true)
  [[ $f == *JetBrains* ]] && echo "$f"
  return 0
}

grub_apply() {
  step "Fonts"
  local tmp regular bold
  tmp="$(mktemp -d)"
  regular=$(grub_font_src Regular)
  bold=$(grub_font_src Bold)
  if [[ -z $regular || -z $bold ]] && ((!DRY_RUN)); then
    die "JetBrains Mono not found (install ttf-jetbrains-mono)"
  fi
  # Names must match theme.txt: "Roxy Mono Regular 16" etc.
  run grub-mkfont -n "Roxy Mono" -s 14 -o "$tmp/roxy-regular-14.pf2" "$regular"
  run grub-mkfont -n "Roxy Mono" -s 16 -o "$tmp/roxy-regular-16.pf2" "$regular"
  run grub-mkfont -n "Roxy Mono" -s 16 -o "$tmp/roxy-bold-16.pf2" "$bold"
  ok "Fonts built"

  step "Theme files"
  run sudo install -d "$GRUB_THEME_DIR"
  run sudo cp "$REPO"/grub/roxy/* "$tmp"/*.pf2 "$GRUB_THEME_DIR/"
  rm -rf "$tmp"
  ok "Copied to $GRUB_THEME_DIR"

  step "GRUB config"
  if [[ ! -f $STATE_DIR/grub-default.orig ]]; then
    run mkdir -p "$STATE_DIR"
    run cp "$GRUB_DEFAULT_FILE" "$STATE_DIR/grub-default.orig"
    ok "Original saved to $STATE_DIR/grub-default.orig"
  fi
  local line="GRUB_THEME=\"$GRUB_THEME_DIR/theme.txt\""
  if grep -qE '^#?GRUB_THEME=' "$GRUB_DEFAULT_FILE"; then
    run sudo sed -i -E "s|^#?GRUB_THEME=.*|$line|" "$GRUB_DEFAULT_FILE"
  else
    run sudo sed -i "\$a $line" "$GRUB_DEFAULT_FILE"
  fi
  ok "Set $line"
  # A theme needs the graphical terminal
  if grep -qE '^GRUB_TERMINAL_OUTPUT=.*console' "$GRUB_DEFAULT_FILE"; then
    run sudo sed -i -E 's|^(GRUB_TERMINAL_OUTPUT=.*console.*)|#\1|' "$GRUB_DEFAULT_FILE"
    warn "Commented out GRUB_TERMINAL_OUTPUT=console"
  fi

  step "grub.cfg"
  run sudo grub-mkconfig -o /boot/grub/grub.cfg
  ok "Rebuilt /boot/grub/grub.cfg"
}

cmd_grub() {
  local action=${1:-install}
  need_arch
  need_grub
  header
  case $action in
    install)
      info "Copies the Roxy theme to $GRUB_THEME_DIR and sets GRUB_THEME (needs sudo)"
      confirm "Install the GRUB theme?" || exit 0
      step "Dependencies"
      install_deps ttf-jetbrains-mono
      grub_apply
      printf '\n%sDone.%s Reboot to see the new boot menu.\n\n' "$c_ok" "$c_reset"
      ;;
    remove)
      confirm "Remove the Roxy GRUB theme?" || exit 0
      step "GRUB config"
      # Only comment out our line; restoring the old file would drop later edits
      run sudo sed -i -E "s|^GRUB_THEME=\"$GRUB_THEME_DIR/theme.txt\"|#&|" "$GRUB_DEFAULT_FILE"
      ok "Commented out GRUB_THEME"
      step "Theme files"
      run sudo rm -rf "$GRUB_THEME_DIR"
      ok "Removed $GRUB_THEME_DIR"
      step "grub.cfg"
      run sudo grub-mkconfig -o /boot/grub/grub.cfg
      ok "Rebuilt /boot/grub/grub.cfg"
      [[ -f $STATE_DIR/grub-default.orig ]] && info "Your original /etc/default/grub is kept at $STATE_DIR/grub-default.orig"
      return 0
      ;;
    *) die "Unknown grub action: $action (install or remove)" ;;
  esac
}

# ── Commands ─────────────────────────────────────────────────

cmd_install() {
  need_arch
  local pkgs=("$@") p
  ((${#pkgs[@]})) || pkgs=("${PACKAGES[@]}")

  header
  info "Packages: ${pkgs[*]}"
  ((DRY_RUN)) && info "Dry run, nothing will be changed"
  confirm "Install and link these?" || exit 0

  step "Dependencies"
  mapfile -t deps < <(deps_of "${pkgs[@]}")
  install_deps stow "${deps[@]}"

  local backup
  backup="$(new_backup_dir install)"
  for p in "${pkgs[@]}"; do
    step "$p"
    backup_conflicts "$p" "$backup"
    stow_pkg -R "$p"
    ok "Config linked"
    run_post "$p"
  done

  step "roxy command"
  link_self
  [[ -d $backup ]] && info "Old configs were moved to $backup"
  printf '\n%sDone.%s Open a new terminal to see the changes.\n\n' "$c_ok" "$c_reset"
}

cmd_update() {
  need_arch
  local requested=("$@") pkgs=("$@")
  ((${#pkgs[@]})) || mapfile -t pkgs < <(installed_packages)
  ((${#pkgs[@]})) || die "Nothing installed yet, run: roxy install"

  header
  if ((!NO_PULL)); then
    step "Dotfiles"
    [[ -z $(git -C "$REPO" status --porcelain --untracked-files=no) ]] \
      || die "The repo has local changes. Commit or stash them first (cd $REPO)."
    local before after
    before=$(git -C "$REPO" rev-parse HEAD)
    run git -C "$REPO" pull --ff-only
    after=$(git -C "$REPO" rev-parse HEAD)
    if [[ $before == "$after" ]]; then
      ok "Already up to date"
    else
      ok "Updated $(git -C "$REPO" rev-parse --short "$before") → $(git -C "$REPO" rev-parse --short "$after")"
      # Continue with the freshly pulled version of this script
      local flags=(--no-pull)
      ((ASSUME_YES)) && flags+=(-y)
      exec "$REPO/roxy" update "${flags[@]}" "${requested[@]}"
    fi
  fi

  step "Backup"
  snapshot_pkgs update "${pkgs[@]}"

  step "Dependencies"
  mapfile -t deps < <(deps_of "${pkgs[@]}")
  install_deps "${deps[@]}"

  local p
  for p in "${pkgs[@]}"; do
    step "$p"
    backup_conflicts "$p" "$LAST_BACKUP"
    stow_pkg -R "$p"
    ok "Relinked"
    run_post "$p"
  done

  # A plain `roxy update` also refreshes an installed GRUB theme
  if ((${#requested[@]} == 0)) && [[ -d $GRUB_THEME_DIR ]] && command -v grub-mkconfig >/dev/null; then
    grub_apply
  fi
  printf '\n%sDone.%s\n\n' "$c_ok" "$c_reset"
}

cmd_remove() {
  (($#)) || die "Name the packages to remove, e.g.: roxy remove spicetify"
  command -v stow >/dev/null || ((DRY_RUN)) || die "stow is not installed"
  local p
  for p in "$@"; do
    step "$p"
    stow_pkg -D "$p"
    ok "Config unlinked"
  done
  info "Backups of your old configs: roxy restore"
}

cmd_backup() {
  local pkgs=("$@")
  ((${#pkgs[@]})) || pkgs=("${PACKAGES[@]}")
  header
  step "Backup"
  snapshot_pkgs manual "${pkgs[@]}"
  [[ -n $LAST_BACKUP && -d $LAST_BACKUP ]] && info "$LAST_BACKUP"
  return 0
}

cmd_restore() {
  local name=${1:-} b
  header

  if [[ -z $name ]]; then
    step "Backups"
    local found=0 count
    while IFS= read -r b; do
      found=1
      count=$(find "$BACKUP_ROOT/$b" -type f | wc -l)
      printf '  %-34s %s%s files%s\n' "$b" "$c_muted" "${count// /}" "$c_reset"
    done < <(list_backups)
    if ((found)); then
      info "Put one back with: roxy restore <name>   (or: roxy restore latest)"
    else
      info "No backups yet. Create one with: roxy backup"
    fi
    return 0
  fi

  [[ $name == latest ]] && name=$(list_backups | head -n 1)
  local src="$BACKUP_ROOT/$name"
  [[ -n $name && -d $src ]] || die "No backup named ${1} (list them with: roxy restore)"

  local files=() f
  while IFS= read -r f; do files+=("$f"); done < <(cd "$src" && find . -type f | sed 's|^\./||' | sort)
  ((${#files[@]})) || die "Backup $name is empty"

  step "Restore $name"
  for f in "${files[@]}"; do info "~/$f"; done
  confirm "Put these ${#files[@]} files back? The current state is backed up first." || exit 0

  step "Safety backup"
  snapshot_files before-restore "${files[@]}"

  step "Restoring"
  for f in "${files[@]}"; do
    run mkdir -p "$HOME/$(dirname "$f")"
    # Drop roxy's symlink first so the copy does not land in the repo
    [[ -L $HOME/$f ]] && run rm "$HOME/$f"
    run cp "$src/$f" "$HOME/$f"
  done
  ok "Restored $name"
  info "Restored files are plain copies. To link a package again: roxy install <package>"
}

cmd_status() {
  header
  printf '  %s%-12s %-10s %s%s\n' "$c_muted" "PACKAGE" "CONFIG" "DEPENDENCIES" "$c_reset"
  local p state d missing color
  for p in "${PACKAGES[@]}"; do
    state=$(link_state "$p")
    missing=()
    for d in ${DEPS[$p]}; do has_pkg "$d" || missing+=("$d"); done
    case $state in
      linked) color=$c_ok ;;
      partial) color=$c_warn ;;
      *) color=$c_muted ;;
    esac
    if ((${#missing[@]})); then
      printf '  %-12s %s%-10s%s %smissing: %s%s\n' "$p" "$color" "$state" "$c_reset" "$c_danger" "${missing[*]}" "$c_reset"
    else
      printf '  %-12s %s%-10s%s %sok%s\n' "$p" "$color" "$state" "$c_reset" "$c_ok" "$c_reset"
    fi
  done

  step "Checks"
  command -v pacman >/dev/null || warn "pacman not found, dependency checks are skipped"
  command -v stow >/dev/null && ok "stow installed" || warn "stow missing (roxy install takes care of it)"

  if command -v fc-list >/dev/null; then
    fc-list | grep -qiE "jetbrains ?mono" && ok "Font JetBrains Mono installed" \
      || warn "Font JetBrains Mono missing, Spotify, Vesktop and GRUB need it (pacman -S ttf-jetbrains-mono)"
  fi

  [[ -f $REPO/assets/roxy.png ]] && ok "fastfetch logo found" \
    || warn "No fastfetch logo at assets/roxy.png"

  command -v spotify >/dev/null || command -v spotify-launcher >/dev/null \
    || warn "Spotify not found, the spicetify theme needs it"

  if grep -qs fastfetch /usr/share/cachyos-fish-config/cachyos-config.fish; then
    warn "CachyOS's fish config runs fastfetch too, you may see it twice"
    info "Fix: remove the cachyos-config line in ~/.config/fish/config.fish, or keep theirs and drop fish_greeting in conf.d/roxy.fish"
  fi

  [[ :$PATH: == *":$HOME/.local/bin:"* ]] || warn "~/.local/bin is not in PATH, the roxy command will not be found"

  if [[ -f /boot/grub/grub.cfg ]]; then
    [[ -d $GRUB_THEME_DIR ]] && ok "GRUB theme installed" || info "GRUB theme not installed (roxy grub)"
  fi

  local conflicts
  conflicts=$(notification_conflicts | tr '\n' ' ')
  if [[ -n ${conflicts// /} ]]; then
    warn "Other notification daemons active: ${conflicts}(roxy install quickshell turns them off)"
  fi

  if [[ -d $VENCORD_SRC/dist ]]; then
    ok "Vencord build with ShellBridge ($(cat "$STATE_DIR/vencord-build" 2>/dev/null || echo "unknown version"))"
  fi

  local backups
  backups=$(list_backups | wc -l)
  info "${backups// /} backups in $BACKUP_ROOT (roxy restore)"
  echo
}

# ── Main ─────────────────────────────────────────────────────

main() {
  local cmd=help args=() a
  if (($#)); then cmd=$1; shift; fi
  while (($#)); do
    case $1 in
      -n | --dry-run) DRY_RUN=1 ;;
      -y | --yes) ASSUME_YES=1 ;;
      --no-pull) NO_PULL=1 ;;
      -h | --help) cmd=help ;;
      -*) die "Unknown option: $1" ;;
      *) args+=("$1") ;;
    esac
    shift
  done

  case $cmd in
    install | i | update | up | remove | rm | uninstall | backup)
      for a in "${args[@]}"; do
        is_package "$a" || die "Unknown package: $a (available: ${PACKAGES[*]})"
      done
      ;;
  esac

  case $cmd in
    install | i) cmd_install "${args[@]}" ;;
    update | up) cmd_update "${args[@]}" ;;
    remove | rm | uninstall) cmd_remove "${args[@]}" ;;
    backup) cmd_backup "${args[@]}" ;;
    restore) cmd_restore "${args[@]}" ;;
    grub) cmd_grub "${args[@]}" ;;
    status | st | doctor) cmd_status ;;
    help) usage ;;
    *) die "Unknown command: $cmd (try: roxy help)" ;;
  esac
}

# Kept on one line: update may replace this file while it runs
main "$@"; exit $?
