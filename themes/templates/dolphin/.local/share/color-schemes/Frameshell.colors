# {{name}} for KDE apps (Dolphin). Generated by frame theme from themes/<theme>.json,
# edit themes/templates/dolphin/.local/share/color-schemes/Frameshell.colors instead.

[ColorEffects:Disabled]
Color={{colors.surface|rgb}}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{colors.surface|rgb}}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate={{colors.surface2|rgb}}
BackgroundNormal={{colors.surface|rgb}}
DecorationFocus={{colors.primary|rgb}}
DecorationHover={{colors.secondary|rgb}}
ForegroundActive={{colors.secondary|rgb}}
ForegroundInactive={{colors.muted|rgb}}
ForegroundLink={{colors.secondary|rgb}}
ForegroundNegative={{colors.danger|rgb}}
ForegroundNeutral={{colors.warn|rgb}}
ForegroundNormal={{colors.text|rgb}}
ForegroundPositive={{colors.ok|rgb}}
ForegroundVisited={{colors.accent|rgb}}

