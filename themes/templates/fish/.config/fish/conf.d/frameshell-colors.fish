# {{name}} – fish syntax colors. Generated by `frame theme`;
# edit themes/templates/fish/.config/fish/conf.d/frameshell-colors.fish instead.

status is-interactive; or return

set -g fish_color_normal {{colors.text|bare}}
set -g fish_color_command {{colors.secondary|bare}}
set -g fish_color_keyword {{colors.accent|bare}}
set -g fish_color_param {{colors.text|bare}}
set -g fish_color_option {{colors.secondary|bare}}
set -g fish_color_quote {{colors.ok|bare}}
set -g fish_color_redirection {{ansi.6|bare}}
set -g fish_color_end {{colors.muted|bare}}
set -g fish_color_operator {{colors.primary|bare}}
set -g fish_color_escape {{ansi.6|bare}}
set -g fish_color_error {{colors.danger|bare}}
set -g fish_color_comment {{colors.frame|bare}}
set -g fish_color_autosuggestion {{colors.frame|bare}}
set -g fish_color_valid_path --underline
set -g fish_color_cancel {{colors.danger|bare}}
set -g fish_color_search_match --background={{colors.surface2|bare}}
set -g fish_color_selection --background={{colors.surface2|bare}}

set -g fish_pager_color_prefix {{colors.primary|bare}} --bold
set -g fish_pager_color_completion {{colors.text|bare}}
set -g fish_pager_color_description {{colors.muted|bare}}
set -g fish_pager_color_progress {{colors.muted|bare}}
set -g fish_pager_color_selected_background --background={{colors.surface2|bare}}
