        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",

        "editor.background": "{{colors.bg}}",
        "editor.foreground": "{{colors.text}}",
        "editor.gutter.background": "{{colors.bg}}",
        "editor.subheader.background": "{{colors.surface}}",
        "editor.active_line.background": "{{colors.secondary|alpha:0f}}",
        "editor.highlighted_line.background": "{{colors.surface}}",
        "editor.line_number": "{{colors.frame}}",
        "editor.active_line_number": "{{colors.text}}",
        "editor.hover_line_number": "{{colors.textDim}}",
        "editor.invisible": "{{colors.surface2}}",
        "editor.wrap_guide": "{{colors.surface2}}",
        "editor.active_wrap_guide": "{{colors.frame}}",
        "editor.indent_guide": "{{colors.surface2}}",
        "editor.indent_guide_active": "{{colors.frame}}",
        "editor.document_highlight.read_background": "{{colors.primary|alpha:1f}}",
        "editor.document_highlight.write_background": "{{colors.primary|alpha:33}}",
        "editor.document_highlight.bracket_background": "{{colors.primary|alpha:33}}",

        "version_control.added": "{{colors.green}}",
        "version_control.modified": "{{colors.warn}}",
        "version_control.deleted": "{{colors.danger}}",

        "terminal.background": "{{colors.bg}}",
