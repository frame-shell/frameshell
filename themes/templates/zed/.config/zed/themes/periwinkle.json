        "conflict.background": "{{colors.warn|alpha:1a}}",
        "conflict.border": "{{colors.warn}}",
        "created": "{{colors.green}}",
        "created.background": "{{colors.green|alpha:1a}}",
        "created.border": "{{colors.green}}",
        "deleted": "{{colors.danger}}",
        "deleted.background": "{{colors.danger|alpha:1a}}",
        "deleted.border": "{{colors.danger}}",
        "error": "{{colors.danger}}",
        "error.background": "{{colors.danger|alpha:1a}}",
        "error.border": "{{colors.danger}}",
        "hidden": "{{colors.frame}}",
        "hidden.background": "#00000000",
        "hidden.border": "{{colors.surface2}}",
        "hint": "{{colors.muted}}",
        "hint.background": "{{colors.muted|alpha:1a}}",
        "hint.border": "{{colors.surface2}}",
        "ignored": "{{colors.frame}}",
        "ignored.background": "#00000000",
        "ignored.border": "{{colors.surface2}}",
        "info": "{{colors.secondary}}",
        "info.background": "{{colors.secondary|alpha:1a}}",
