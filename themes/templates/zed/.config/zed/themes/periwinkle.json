        "terminal.ansi.dim_black": "{{ansi.0}}",
        "terminal.ansi.dim_red": "{{ansi.1|alpha:b3}}",
        "terminal.ansi.dim_green": "{{ansi.2|alpha:b3}}",
        "terminal.ansi.dim_yellow": "{{ansi.3|alpha:b3}}",
        "terminal.ansi.dim_blue": "{{ansi.4|alpha:b3}}",
        "terminal.ansi.dim_magenta": "{{ansi.5|alpha:b3}}",
        "terminal.ansi.dim_cyan": "{{ansi.6|alpha:b3}}",
        "terminal.ansi.dim_white": "{{ansi.7|alpha:b3}}",

