          "punctuation.markup": { "color": "{{colors.primary}}", "font_style": null, "font_weight": null },
          "punctuation.special": { "color": "{{colors.violet}}", "font_style": null, "font_weight": null },
          "selector": { "color": "{{colors.primary}}", "font_style": null, "font_weight": null },
          "selector.pseudo": { "color": "{{colors.violet}}", "font_style": null, "font_weight": null },
          "string": { "color": "{{colors.green}}", "font_style": null, "font_weight": null },
          "string.escape": { "color": "{{ansi.6}}", "font_style": null, "font_weight": null },
          "string.regex": { "color": "{{ansi.6}}", "font_style": null, "font_weight": null },
          "string.special": { "color": "{{ansi.6}}", "font_style": null, "font_weight": null },
          "string.special.symbol": { "color": "{{colors.green}}", "font_style": null, "font_weight": null },
          "tag": { "color": "{{colors.primary}}", "font_style": null, "font_weight": null },
          "text.literal": { "color": "{{colors.green}}", "font_style": null, "font_weight": null },
          "title": { "color": "{{colors.text}}", "font_style": null, "font_weight": 700 },
          "type": { "color": "{{colors.secondary}}", "font_style": null, "font_weight": null },
          "variable": { "color": "{{colors.text}}", "font_style": null, "font_weight": null },
          "variable.parameter": { "color": "{{colors.textDim}}", "font_style": null, "font_weight": null },
          "variable.special": { "color": "{{colors.danger}}", "font_style": null, "font_weight": null },
          "variant": { "color": "{{colors.secondary}}", "font_style": null, "font_weight": null }
