{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "{{name}}",
  "author": "roxy-dots (generated by roxy theme from themes/roxy.json)",
  "themes": [
    {
      "name": "{{name}}",
      "appearance": "dark",
      "style": {
        "background": "{{colors.bg}}",
        "background.appearance": "opaque",
        "surface.background": "{{colors.bg}}",
        "elevated_surface.background": "{{colors.surface}}",
        "panel.background": "{{colors.bg}}",
        "panel.focused_border": "{{colors.primary}}",
        "panel.indent_guide": "{{colors.surface2}}",
        "panel.indent_guide_active": "{{colors.frame}}",
        "panel.indent_guide_hover": "{{colors.frame}}",
        "pane.focused_border": "{{colors.primary}}",
        "pane_group.border": "{{colors.surface2}}",
        "drop_target.background": "{{colors.primary|alpha:33}}",

        "border": "{{colors.surface2}}",
        "border.variant": "{{colors.surface2}}",
        "border.focused": "{{colors.primary}}",
        "border.selected": "{{colors.primary}}",
        "border.transparent": "#00000000",
        "border.disabled": "{{colors.surface2}}",

        "element.background": "{{colors.surface}}",
        "element.hover": "{{colors.surface2}}",
        "element.active": "{{colors.shadow}}",
        "element.selected": "{{colors.primary|alpha:29}}",
        "element.disabled": "{{colors.surface}}",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{colors.secondary|alpha:0f}}",
        "ghost_element.active": "{{colors.primary|alpha:29}}",
        "ghost_element.selected": "{{colors.primary|alpha:29}}",
        "ghost_element.disabled": "#00000000",

        "text": "{{colors.text}}",
        "text.muted": "{{colors.muted}}",
        "text.placeholder": "{{colors.frame}}",
        "text.disabled": "{{colors.frame}}",
        "text.accent": "{{colors.secondary}}",
        "icon": "{{colors.textDim}}",
        "icon.muted": "{{colors.muted}}",
        "icon.disabled": "{{colors.frame}}",
        "icon.placeholder": "{{colors.frame}}",
        "icon.accent": "{{colors.secondary}}",
        "link_text.hover": "{{colors.secondary}}",

        "title_bar.background": "{{colors.bg}}",
        "title_bar.inactive_background": "{{colors.bg}}",
        "status_bar.background": "{{colors.bg}}",
        "toolbar.background": "{{colors.bg}}",
