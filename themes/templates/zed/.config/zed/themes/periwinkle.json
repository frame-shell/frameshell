        "unreachable.border": "{{colors.surface2}}",
        "warning": "{{colors.warn}}",
        "warning.background": "{{colors.warn|alpha:1a}}",
        "warning.border": "{{colors.warn}}",

        "players": [
          { "cursor": "{{colors.secondary}}", "background": "{{colors.secondary}}", "selection": "{{colors.primary|alpha:4d}}" },
          { "cursor": "{{colors.violet}}", "background": "{{colors.violet}}", "selection": "{{colors.violet|alpha:4d}}" },
          { "cursor": "{{colors.green}}", "background": "{{colors.green}}", "selection": "{{colors.green|alpha:4d}}" },
          { "cursor": "{{colors.warn}}", "background": "{{colors.warn}}", "selection": "{{colors.warn|alpha:4d}}" }
        ],

        "syntax": {
          "attribute": { "color": "{{colors.violet}}", "font_style": null, "font_weight": null },
          "boolean": { "color": "{{colors.warn}}", "font_style": null, "font_weight": null },
          "comment": { "color": "{{colors.muted}}", "font_style": "italic", "font_weight": null },
