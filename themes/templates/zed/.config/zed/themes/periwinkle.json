          "embedded": { "color": "{{colors.text}}", "font_style": null, "font_weight": null },
          "emphasis": { "color": "{{colors.secondary}}", "font_style": "italic", "font_weight": null },
          "emphasis.strong": { "color": "{{colors.secondary}}", "font_style": null, "font_weight": 700 },
          "enum": { "color": "{{colors.secondary}}", "font_style": null, "font_weight": null },
          "function": { "color": "{{colors.primary}}", "font_style": null, "font_weight": null },
          "hint": { "color": "{{colors.muted}}", "font_style": null, "font_weight": null },
          "keyword": { "color": "{{colors.violet}}", "font_style": null, "font_weight": null },
          "diff.minus": { "color": "{{colors.danger}}", "font_style": null, "font_weight": null },
          "diff.plus": { "color": "{{colors.green}}", "font_style": null, "font_weight": null },
          "label": { "color": "{{colors.secondary}}", "font_style": null, "font_weight": null },
          "namespace": { "color": "{{colors.textDim}}", "font_style": null, "font_weight": null },
          "link_text": { "color": "{{colors.secondary}}", "font_style": null, "font_weight": null },
          "link_uri": { "color": "{{ansi.6}}", "font_style": null, "font_weight": null },
          "number": { "color": "{{colors.warn}}", "font_style": null, "font_weight": null },
          "operator": { "color": "{{colors.textDim}}", "font_style": null, "font_weight": null },
          "predictive": { "color": "{{colors.frame}}", "font_style": "italic", "font_weight": null },
          "preproc": { "color": "{{colors.violet}}", "font_style": null, "font_weight": null },
          "primary": { "color": "{{colors.text}}", "font_style": null, "font_weight": null },
          "property": { "color": "{{colors.textDim}}", "font_style": null, "font_weight": null },
          "punctuation": { "color": "{{colors.frame}}", "font_style": null, "font_weight": null },
          "punctuation.bracket": { "color": "{{colors.muted}}", "font_style": null, "font_weight": null },
          "punctuation.delimiter": { "color": "{{colors.frame}}", "font_style": null, "font_weight": null },
